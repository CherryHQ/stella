{
  "name": "bash",
  "version": "1.0.0",
  "kind": "tool",
  "protocol_version": "anna-plugin/v1",
  "entrypoint": "@anna",
  "args": ["tool", "bash"],
  "capabilities": ["tool.call", "health.check", "shutdown.graceful"],
  "tool": {
    "name": "bash",
    "description": "Execute a bash command. Use for file operations like ls, rg, find, git, and other shell commands.",
    "input_schema": {
      "type": "object",
      "properties": {
        "command": {
          "type": "string",
          "description": "The bash command to execute."
        }
      },
      "required": ["command"]
    }
  }
}
