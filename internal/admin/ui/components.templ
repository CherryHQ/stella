package ui

// PageHeader renders a consistent page title block.
templ PageHeader(title string, subtitle string) {
	<div class="mb-8">
		<h1 class="font-serif text-3xl md:text-4xl tracking-tight mb-2">{ title }</h1>
		if subtitle != "" {
			<p class="text-secondary text-sm max-w-lg">{ subtitle }</p>
		}
	</div>
}

// EmptyState renders a centered placeholder message.
templ EmptyState(message string) {
	<div class="text-center py-16">
		<p class="text-secondary text-sm">{ message }</p>
	</div>
}

// Badge renders a daisyUI badge with the given variant.
// Supported variants: primary, secondary, accent, ghost, info, success, warning, error.
templ Badge(text string, variant string) {
	<span class={ "badge", badgeVariantClass(variant) }>{ text }</span>
}

func badgeVariantClass(variant string) string {
	switch variant {
	case "primary":
		return "badge-primary"
	case "secondary":
		return "badge-secondary"
	case "accent":
		return "badge-accent"
	case "ghost":
		return "badge-ghost"
	case "info":
		return "badge-info"
	case "success":
		return "badge-success"
	case "warning":
		return "badge-warning"
	case "error":
		return "badge-error"
	default:
		return ""
	}
}

// FormField renders a labeled form field wrapper. The input content is provided as children.
templ FormField(label string) {
	<div class="form-control w-full">
		<label class="label">
			<span class="label-text font-mono font-medium text-sm">{ label }</span>
		</label>
		{ children... }
	</div>
}
