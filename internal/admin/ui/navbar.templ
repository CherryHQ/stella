package ui

type navItem struct {
	ID       string
	Label    string
	Href     string
	AdminOnly bool
}

var navItems = []navItem{
	{ID: "providers", Label: "Providers", Href: "/providers", AdminOnly: true},
	{ID: "agents", Label: "Agents", Href: "/agents"},
	{ID: "channels", Label: "Channels", Href: "/channels"},
	{ID: "users", Label: "Users", Href: "/users", AdminOnly: true},
	{ID: "sessions", Label: "Sessions", Href: "/sessions"},
	{ID: "scheduler", Label: "Scheduler", Href: "/scheduler"},
	{ID: "plugins", Label: "Plugins", Href: "/plugins", AdminOnly: true},
	{ID: "skills", Label: "Skills", Href: "/skills", AdminOnly: true},
}

func visibleNavItems(isAdmin bool) []navItem {
	var items []navItem
	for _, item := range navItems {
		if !item.AdminOnly || isAdmin {
			items = append(items, item)
		}
	}
	return items
}

templ Navbar(activePage string, username string, isAdmin bool) {
	<header class="border-b border-base-300">
		<div class="max-w-6xl mx-auto px-6 h-14 flex items-center justify-between">
			<!-- Logo -->
			if isAdmin {
				<a href="/providers" class="font-serif italic text-primary text-xl tracking-tight select-none">anna</a>
			} else {
				<a href="/agents" class="font-serif italic text-primary text-xl tracking-tight select-none">anna</a>
			}
			<!-- Desktop nav -->
			<nav class="hidden sm:flex items-center gap-1 text-sm" role="navigation" aria-label="Main">
				for i, item := range visibleNavItems(isAdmin) {
					if i > 0 {
						<span class="text-base-300 mx-2 select-none">/</span>
					}
					if item.ID == activePage {
						<a href={ templ.SafeURL(item.Href) } class="py-1 font-medium text-primary transition-colors">
							{ item.Label }
						</a>
					} else {
						<a href={ templ.SafeURL(item.Href) } class="py-1 font-medium text-secondary hover:text-base-content transition-colors">
							{ item.Label }
						</a>
					}
				}
			</nav>
			<!-- Mobile nav -->
			<div class="sm:hidden">
				<select
					x-data={ "{ page: '" + activePage + "' }" }
					x-model="page"
					@change="window.location.href = '/' + page"
					class="select select-sm select-ghost"
				>
					for _, item := range visibleNavItems(isAdmin) {
						<option
							value={ item.ID }
							selected?={ item.ID == activePage }
						>
							{ item.Label }
						</option>
					}
				</select>
			</div>
			<!-- Right side: user + theme -->
			<div class="flex items-center gap-4">
				<!-- User info + logout -->
				if username != "" {
					<a href="/profile" class="text-xs font-mono text-secondary hover:text-primary transition-colors">{ username }</a>
					<form method="POST" action="/api/auth/logout" class="inline">
						<button type="submit" class="btn btn-ghost btn-xs text-secondary hover:text-error"
							onclick="event.preventDefault(); fetch('/api/auth/logout', {method:'POST',credentials:'same-origin'}).then(()=>window.location.href='/login')">
							logout
						</button>
					</form>
				}
				<!-- Theme switcher -->
				<div x-data class="dropdown dropdown-end">
					<div tabindex="0" role="button" class="btn btn-ghost btn-xs" aria-label="Change theme">
						<svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor">
							<path stroke-linecap="round" stroke-linejoin="round" d="M4.098 19.902a3.75 3.75 0 0 0 5.304 0l6.401-6.402M6.75 21A3.75 3.75 0 0 1 3 17.25V4.125C3 3.504 3.504 3 4.125 3h5.25c.621 0 1.125.504 1.125 1.125v4.072M6.75 21a3.75 3.75 0 0 0 3.75-3.75V8.197M6.75 21h13.125c.621 0 1.125-.504 1.125-1.125v-5.25c0-.621-.504-1.125-1.125-1.125h-4.072M10.5 8.197l2.88-2.88c.438-.439 1.15-.439 1.59 0l3.712 3.713c.44.44.44 1.152 0 1.59l-2.879 2.88M6.75 17.25h.008v.008H6.75v-.008Z"></path>
						</svg>
					</div>
					<ul tabindex="0" class="dropdown-content menu bg-base-200 rounded-box z-10 w-40 p-2 shadow-lg max-h-80 overflow-y-auto">
						for _, theme := range themeList() {
							<li>
								<button @click={ "$store.theme.set('" + theme + "')" } class="text-xs">
									{ theme }
								</button>
							</li>
						}
					</ul>
				</div>
			</div>
		</div>
	</header>
}

