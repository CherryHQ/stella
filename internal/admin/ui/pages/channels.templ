package pages

import "github.com/vaayne/anna/internal/admin/ui"

templ ChannelsPage() {
	<div x-data="channelsPage()">
		@ui.PageHeader("Messaging platforms", "Connect Anna to Telegram, QQ, Feishu, and Weixin.")
		<section class="border-t border-base-300 pt-8">
			<div class="flex items-center justify-between gap-4 mb-6">
				<div>
					<h2 class="text-lg font-medium">Available channels</h2>
					<p class="text-sm text-secondary mt-1">Link the platform account on the channel you use. Dedicated channels always use their bound agent.</p>
				</div>
				<span class="text-xs font-mono text-secondary" x-text="linkedIdentities.length + ' linked'"></span>
			</div>
			<template x-if="loadingLinks">
				<div class="flex justify-center py-8">
					<span class="loading loading-spinner loading-sm"></span>
				</div>
			</template>
			<div x-show="!loadingLinks" x-cloak class="divide-y divide-base-300 border-y border-base-300">
				<template x-for="channel in publicChannels" :key="channel.id">
					<div class="py-5 flex flex-col md:flex-row md:items-center md:justify-between gap-4">
						<div class="min-w-0">
							<div class="flex items-baseline gap-3 flex-wrap">
								<span class="font-medium" x-text="channelTitle(channel)"></span>
								<span class="badge badge-ghost badge-sm" x-text="channel.type"></span>
								<span class="badge badge-sm" :class="isLinked(channel.type) ? 'badge-success' : 'badge-ghost'" x-text="isLinked(channel.type) ? 'linked' : 'not linked'"></span>
							</div>
							<template x-if="channel.agent_id">
								<p class="text-sm mt-1">
									<span class="text-secondary">Uses agent </span>
									<a :href="agentHref(channel)" class="link link-primary font-mono" x-text="agentLabel(channel)"></a>
								</p>
							</template>
							<p class="text-sm text-secondary mt-1" x-text="channelDescription(channel)"></p>
							<template x-if="identityFor(channel.type)">
								<p class="text-xs font-mono text-base-content/50 mt-2" x-text="identityLabel(identityFor(channel.type))"></p>
							</template>
						</div>
						<div class="flex items-center gap-2 shrink-0">
							<button
								x-show="!isLinked(channel.type) && channel.type !== 'weixin'"
								@click="generateCode(channel.type)"
								:disabled="generating"
								class="btn btn-sm btn-outline"
							>
								<span x-show="generating && linkPlatform === channel.type" class="loading loading-spinner loading-xs"></span>
								<span x-text="'Link ' + channel.label"></span>
							</button>
							<button
								x-show="!isLinked(channel.type) && channel.type === 'weixin'"
								@click="startWeixinQR()"
								:disabled="wxQrPolling"
								class="btn btn-sm btn-outline"
							>
								<span x-show="wxQrPolling" class="loading loading-spinner loading-xs"></span>
								Link Weixin
							</button>
							<button
								x-show="isLinked(channel.type)"
								@click="unlinkIdentity(identityFor(channel.type)?.id)"
								class="btn btn-ghost btn-xs text-secondary hover:text-error"
							>unlink</button>
						</div>
					</div>
				</template>
				<template x-if="publicChannels.length === 0">
					<div class="py-8 text-sm text-secondary">No enabled messaging channels are available.</div>
				</template>
			</div>
			<template x-if="linkCode">
				<div class="alert shadow-md mt-4">
					<div>
						<p class="font-medium">Send this command to Anna on <span x-text="platformLabel[linkPlatform] || linkPlatform"></span>:</p>
						<div class="flex items-center gap-2 mt-2">
							<code class="font-mono text-lg font-bold bg-base-200 text-base-content px-3 py-1 rounded select-all" x-text="'/link ' + linkCode"></code>
							<button @click="copyLinkCode()" class="btn btn-ghost btn-xs">copy</button>
						</div>
						<p class="text-xs text-secondary mt-2">Expires in 5 minutes.</p>
					</div>
				</div>
			</template>
			<template x-if="wxQrUrl">
				<div class="card bg-base-200 mt-4">
					<div class="card-body py-4 items-center">
						<p class="text-sm font-medium mb-2">Scan with WeChat to link your account</p>
						<img :src="wxQrUrl" alt="WeChat QR Code" class="w-48 h-48 border rounded"/>
						<span
							class="badge badge-sm mt-2"
							:class="{
								'badge-warning': wxQrStatus === 'waiting',
								'badge-info': wxQrStatus === 'scaned',
								'badge-success': wxQrStatus === 'confirmed',
								'badge-error': wxQrStatus === 'expired',
							}"
							x-text="wxQrStatus"
						></span>
						<template x-if="wxQrStatus === 'expired'">
							<button @click="startWeixinQR()" class="btn btn-outline btn-xs mt-1">Refresh</button>
						</template>
					</div>
				</div>
			</template>
		</section>
		<div x-show="isAdmin" x-cloak class="border-t border-base-300 divide-y divide-base-300 mt-8">
			<p class="text-sm text-secondary py-6">
				Edit channel configuration here. Enable or disable channel plugins on the <a href="/plugins" class="link link-primary">Plugins</a> page.
			</p>
			<!-- Telegram -->
			@channelBlock("Telegram", "telegram") {
				<label class="flex items-center gap-3 cursor-pointer">
					<input
						type="checkbox"
						:checked="channelData.telegram.enable_notify"
						@change="channelData.telegram.enable_notify = $event.target.checked"
						class="toggle toggle-primary toggle-sm"
					/>
					<span class="text-sm">Notifications</span>
				</label>
				<div>
					@ui.FormField("Bot Token") {
						<input
							type="password"
							x-model="channelData.telegram.token"
							placeholder="From @BotFather"
							class="input input-bordered w-full text-sm font-mono"
						/>
					}
				</div>
				<div class="grid grid-cols-1 sm:grid-cols-2 gap-x-8 gap-y-4">
					<div>
						@ui.FormField("Channel ID") {
							<input
								type="text"
								x-model="channelData.telegram.channel_id"
								placeholder="Default channel"
								class="input input-bordered w-full text-sm"
							/>
						}
					</div>
					<div>
						@ui.FormField("Group Mode") {
							<select x-model="channelData.telegram.group_mode" class="select select-bordered w-full text-sm">
								<option value="">Default</option>
								<option value="mention">Mention</option>
								<option value="always">Always</option>
								<option value="disabled">Disabled</option>
							</select>
						}
					</div>
				</div>
				<button @click="saveChannel('telegram')" class="btn btn-primary btn-sm">Save Telegram</button>
			}
			<!-- QQ -->
			@channelBlock("QQ", "qq") {
				<label class="flex items-center gap-3 cursor-pointer">
					<input
						type="checkbox"
						:checked="channelData.qq.enable_notify"
						@change="channelData.qq.enable_notify = $event.target.checked"
						class="toggle toggle-primary toggle-sm"
					/>
					<span class="text-sm">Notifications</span>
				</label>
				<div class="grid grid-cols-1 sm:grid-cols-2 gap-x-8 gap-y-4">
					<div>
						@ui.FormField("App ID") {
							<input
								type="text"
								x-model="channelData.qq.app_id"
								placeholder="QQ Bot App ID"
								class="input input-bordered w-full text-sm font-mono"
							/>
						}
					</div>
					<div>
						@ui.FormField("App Secret") {
							<input
								type="password"
								x-model="channelData.qq.app_secret"
								class="input input-bordered w-full text-sm font-mono"
							/>
						}
					</div>
					<div>
						@ui.FormField("Group Mode") {
							<select x-model="channelData.qq.group_mode" class="select select-bordered w-full text-sm">
								<option value="">Default (mention)</option>
								<option value="mention">Mention</option>
								<option value="always">Always</option>
								<option value="disabled">Disabled</option>
							</select>
						}
					</div>
				</div>
				<button @click="saveChannel('qq')" class="btn btn-primary btn-sm">Save QQ</button>
			}
			<!-- Feishu -->
			@channelBlock("Feishu", "feishu") {
				<label class="flex items-center gap-3 cursor-pointer">
					<input
						type="checkbox"
						:checked="channelData.feishu.enable_notify"
						@change="channelData.feishu.enable_notify = $event.target.checked"
						class="toggle toggle-primary toggle-sm"
					/>
					<span class="text-sm">Notifications</span>
				</label>
				<p class="text-xs text-secondary">
					Feishu is chat-only. Add a <code>lark-cli</code> skill yourself if you want Lark workspace automation.
				</p>
				<div class="grid grid-cols-1 sm:grid-cols-2 gap-x-8 gap-y-4">
					<div>
						@ui.FormField("App ID") {
							<input
								type="text"
								x-model="channelData.feishu.app_id"
								class="input input-bordered w-full text-sm font-mono"
							/>
						}
					</div>
					<div>
						@ui.FormField("App Secret") {
							<input
								type="password"
								x-model="channelData.feishu.app_secret"
								class="input input-bordered w-full text-sm font-mono"
							/>
						}
					</div>
					<div>
						@ui.FormField("Encrypt Key") {
							<input
								type="password"
								x-model="channelData.feishu.encrypt_key"
								placeholder="optional"
								class="input input-bordered w-full text-sm font-mono"
							/>
						}
					</div>
					<div>
						@ui.FormField("Verification Token") {
							<input
								type="password"
								x-model="channelData.feishu.verification_token"
								placeholder="optional"
								class="input input-bordered w-full text-sm font-mono"
							/>
						}
					</div>
					<div>
						@ui.FormField("Group Mode") {
							<select x-model="channelData.feishu.group_mode" class="select select-bordered w-full text-sm">
								<option value="">Default (mention)</option>
								<option value="mention">Mention</option>
								<option value="always">Always</option>
								<option value="disabled">Disabled</option>
							</select>
						}
					</div>
				</div>
				<button @click="saveChannel('feishu')" class="btn btn-primary btn-sm">Save Feishu</button>
			}
			<!-- Weixin -->
			@channelBlock("Weixin", "weixin") {
				<label class="flex items-center gap-3 cursor-pointer">
					<input
						type="checkbox"
						:checked="channelData.weixin.enable_notify"
						@change="channelData.weixin.enable_notify = $event.target.checked"
						class="toggle toggle-primary toggle-sm"
					/>
					<span class="text-sm">Notifications</span>
				</label>
				<p class="text-xs text-secondary">
					To connect, go to <a href="/profile" class="link link-primary">Profile</a> and use "Link Weixin" to scan the QR code.
				</p>
				<button @click="saveChannel('weixin')" class="btn btn-primary btn-sm">Save Weixin</button>
			}
		</div>
		<div x-show="isAdmin" x-cloak class="border-t border-base-300 pt-8 mt-8">
			<div class="flex items-center justify-between gap-4 mb-6">
				<div>
					<h2 class="text-lg font-medium">Channel instances</h2>
					<p class="text-sm text-secondary mt-1">Use separate bot credentials for dedicated agents or teams.</p>
				</div>
				<span class="text-xs font-mono text-secondary" x-text="channels.length + ' instances'"></span>
			</div>
			<div class="border border-base-300 rounded-xl p-4 mb-8 space-y-4">
				<p class="text-xs font-mono font-medium text-secondary uppercase tracking-wider">New instance</p>
				<div class="grid grid-cols-1 md:grid-cols-3 gap-4">
					<div>
						@ui.FormField("ID") {
							<input x-model="newChannel.id" type="text" placeholder="feishu-coder" class="input input-bordered w-full text-sm font-mono"/>
						}
					</div>
					<div>
						@ui.FormField("Type") {
							<select x-model="newChannel.type" class="select select-bordered w-full text-sm">
								<template x-for="type in visibleChannelTypes" :key="type.id">
									<option :value="type.id" x-text="type.label"></option>
								</template>
							</select>
						}
					</div>
					<div>
						@ui.FormField("Dedicated Agent") {
							<select x-model="newChannel.agent_id" class="select select-bordered w-full text-sm">
								<option value="">All agents</option>
								<template x-for="a in agents" :key="a.id">
									<option :value="a.id" x-text="a.name + ' (' + a.id + ')'"></option>
								</template>
							</select>
						}
					</div>
				</div>
				<div>
					@ui.FormField("Config JSON") {
						<textarea x-model="newChannel.config" rows="5" class="textarea textarea-bordered w-full text-xs font-mono resize-y"></textarea>
					}
				</div>
				<button @click="createChannel()" :disabled="!newChannel.id || !newChannel.type" class="btn btn-primary btn-sm">Create instance</button>
			</div>
			<div class="space-y-8">
				<template x-for="group in groupedChannels" :key="group.type">
					<div>
						<div class="flex items-center gap-3 mb-4">
							<h3 class="text-sm font-medium" x-text="group.type"></h3>
							<span class="text-xs text-secondary" x-text="group.channels.length + ' instances'"></span>
						</div>
						<div class="divide-y divide-base-300 border border-base-300 rounded-xl px-4">
							<template x-for="ch in group.channels" :key="ch.id">
								<div class="py-5">
									<div class="flex items-center justify-between gap-4 mb-4">
										<button @click="ch._collapsed = !ch._collapsed" class="flex items-center gap-3 text-left min-w-0 flex-1 cursor-pointer">
											<span class="text-xs text-secondary" x-text="ch._collapsed ? '▸' : '▾'"></span>
											<div class="flex items-baseline gap-3 flex-wrap min-w-0">
												<span class="font-medium" x-text="ch.id"></span>
												<span class="badge badge-ghost badge-sm" x-text="ch.type"></span>
												<span x-show="ch.agent_id" class="badge badge-primary badge-sm" x-text="'agent: ' + ch.agent_id"></span>
											</div>
										</button>
										<div class="flex items-center gap-2 shrink-0">
											<button @click="ch._collapsed = !ch._collapsed" class="btn btn-ghost btn-xs" x-text="ch._collapsed ? 'Edit' : 'Collapse'"></button>
											<button
												x-show="ch.id !== ch.type"
												@click="confirmDelete('Delete channel instance ' + ch.id + '?', () => doDeleteChannel(ch.id))"
												class="btn btn-ghost btn-xs text-secondary hover:text-error"
											>remove</button>
										</div>
									</div>
									<div x-show="!ch._collapsed" x-cloak class="space-y-4">
										<div class="grid grid-cols-1 md:grid-cols-2 gap-4">
											<div>
												@ui.FormField("Type") {
													<select x-model="ch.type" class="select select-bordered w-full text-sm">
														<template x-for="type in visibleChannelTypes" :key="type.id">
															<option :value="type.id" x-text="type.label"></option>
														</template>
													</select>
												}
											</div>
											<div>
												@ui.FormField("Dedicated Agent") {
													<select x-model="ch.agent_id" class="select select-bordered w-full text-sm">
														<option value="">All agents</option>
														<template x-for="a in agents" :key="a.id">
															<option :value="a.id" x-text="a.name + ' (' + a.id + ')'"></option>
														</template>
													</select>
												}
											</div>
										</div>
										<div>
											@ui.FormField("Config JSON") {
												<textarea x-model="ch.config" rows="7" class="textarea textarea-bordered w-full text-xs font-mono resize-y"></textarea>
											}
										</div>
										<button @click="saveInstance(ch)" class="btn btn-primary btn-sm">Save instance</button>
									</div>
								</div>
							</template>
						</div>
					</div>
				</template>
			</div>
		</div>
		<div x-show="confirmMsg" x-cloak class="fixed inset-0 z-50 flex items-center justify-center bg-black/40">
			<div class="card bg-base-100 shadow-xl w-full max-w-sm" @click.away="confirmMsg = ''">
				<div class="card-body">
					<p class="text-sm" x-text="confirmMsg"></p>
					<div class="card-actions justify-end mt-4">
						<button @click="confirmMsg = ''" class="btn btn-ghost btn-sm">Cancel</button>
						<button @click="confirmAction(); confirmMsg = ''" class="btn btn-error btn-sm">Delete</button>
					</div>
				</div>
			</div>
		</div>
	</div>
}

// channelBlock renders a platform configuration section.
templ channelBlock(name string, platform string) {
	<div class="py-8" x-show={ "channelEnabled('" + platform + "')" } x-cloak>
		<div class="flex items-center justify-between mb-4">
			<div class="flex items-center gap-3">
				<span class="font-medium text-lg">{ name }</span>
			</div>
			<a href="/plugins" class="text-xs text-secondary hover:text-primary transition-colors">Manage plugin</a>
		</div>
		<div class="space-y-4 pl-0 md:pl-6">
			<div>
				@ui.FormField("Dedicated Agent") {
					<select x-model={ "channelData." + platform + ".agent_id" } class="select select-bordered w-full text-sm">
						<option value="">All agents</option>
						<template x-for="a in agents" :key="a.id">
							<option :value="a.id" x-text="a.name + ' (' + a.id + ')'"></option>
						</template>
					</select>
				}
			</div>
			{ children... }
		</div>
	</div>
}
