package pages

import "github.com/vaayne/anna/internal/admin/ui"

templ ProfilePage() {
	<div x-data="profilePage()">
		@ui.PageHeader("Profile", "Manage your account and linked identities.")
		<!-- Password Change -->
		<div class="mb-10">
			<h2 class="font-serif text-xl mb-4">Change Password</h2>
			<div class="card bg-base-200">
				<div class="card-body">
					<div class="grid grid-cols-1 md:grid-cols-3 gap-4">
						@ui.FormField("Current Password") {
							<input
								type="password"
								x-model="currentPassword"
								class="input input-bordered w-full text-sm"
								placeholder="current password"
								autocomplete="current-password"
							/>
						}
						@ui.FormField("New Password") {
							<input
								type="password"
								x-model="newPassword"
								class="input input-bordered w-full text-sm"
								placeholder="min 8 characters"
								minlength="8"
								autocomplete="new-password"
							/>
						}
						@ui.FormField("Confirm New Password") {
							<input
								type="password"
								x-model="confirmPassword"
								class="input input-bordered w-full text-sm"
								placeholder="confirm new password"
								autocomplete="new-password"
							/>
						}
					</div>
					<div class="mt-4">
						<button @click="changePassword()" :disabled="changingPassword" class="btn btn-primary btn-sm">
							<span x-show="changingPassword" class="loading loading-spinner loading-xs"></span>
							Change Password
						</button>
					</div>
				</div>
			</div>
		</div>
		<!-- Linked Identities -->
		<div class="mb-10">
			<h2 class="font-serif text-xl mb-4">Linked Identities</h2>
			<div class="card bg-base-200">
				<div class="card-body">
					<template x-if="identities.length === 0 && !loadingIdentities">
						<p class="text-secondary text-sm">No linked identities yet. Link a platform account below.</p>
					</template>
					<template x-if="loadingIdentities">
						<div class="flex justify-center py-4">
							<span class="loading loading-spinner loading-sm"></span>
						</div>
					</template>
					<div class="divide-y divide-base-300">
						<template x-for="identity in identities" :key="identity.id">
							<div class="flex items-center justify-between py-3">
								<div>
									<span class="badge badge-ghost badge-sm mr-2" x-text="identity.platform"></span>
									<span class="font-mono text-sm" x-text="identity.external_id"></span>
									<template x-if="identity.name">
										<span class="text-secondary text-sm ml-2" x-text="'(' + identity.name + ')'"></span>
									</template>
								</div>
								<button
									@click="unlinkIdentity(identity.id)"
									class="btn btn-ghost btn-xs text-error hover:bg-error/10"
								>
									unlink
								</button>
							</div>
						</template>
					</div>
				</div>
			</div>
		</div>
		<!-- Link New Identity -->
		<div>
			<h2 class="font-serif text-xl mb-4">Link New Identity</h2>
			<div class="card bg-base-200">
				<div class="card-body">
					<p class="text-secondary text-sm mb-4">
						Generate a link code, then send it as a message to the Anna bot on the selected platform.
						The code expires in 5 minutes.
					</p>
					<div class="flex flex-wrap gap-2 mb-4">
						<button @click="generateCode('telegram')" :disabled="generating" class="btn btn-sm btn-outline">
							<span x-show="generating && linkPlatform === 'telegram'" class="loading loading-spinner loading-xs"></span>
							Link Telegram
						</button>
						<button @click="generateCode('qq')" :disabled="generating" class="btn btn-sm btn-outline">
							<span x-show="generating && linkPlatform === 'qq'" class="loading loading-spinner loading-xs"></span>
							Link QQ
						</button>
						<button @click="generateCode('feishu')" :disabled="generating" class="btn btn-sm btn-outline">
							<span x-show="generating && linkPlatform === 'feishu'" class="loading loading-spinner loading-xs"></span>
							Link Feishu
						</button>
					</div>
					<template x-if="linkCode">
						<div class="alert alert-info">
							<div>
								<p class="font-medium">Your link code:</p>
								<p class="font-mono text-2xl tracking-widest mt-1" x-text="linkCode"></p>
								<p class="text-sm mt-2">
									Send this code as a message to the Anna bot on
									<span class="font-medium" x-text="linkPlatform"></span>.
									It will expire in 5 minutes.
								</p>
							</div>
						</div>
					</template>
				</div>
			</div>
		</div>
	</div>
}
