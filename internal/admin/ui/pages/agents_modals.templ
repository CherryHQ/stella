package pages

templ agentTemplateModal() {
	<template x-if="showTemplateModal">
		<div class="modal modal-open">
			<div class="modal-box w-11/12 max-w-2xl">
				<div class="flex items-center justify-between mb-4">
					<h3 class="font-bold text-lg">Start from a template</h3>
					<button @click="showTemplateModal = false" class="btn btn-ghost btn-sm btn-circle">✕</button>
				</div>
				<p class="text-sm text-base-content/60 mb-4">Templates pre-fill the system prompt, skills, and model. You can edit everything before saving.</p>
				<div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
					<template x-for="tmpl in builtinTemplates" :key="tmpl.id">
						<button
							@click="pickTemplate(tmpl)"
							type="button"
							class="text-left border border-base-300 hover:border-primary rounded-box p-4 transition-colors"
						>
							<p class="font-medium text-sm" x-text="tmpl.name"></p>
							<p class="text-xs text-secondary font-mono mt-0.5" x-text="tmpl.id"></p>
							<p class="text-xs text-base-content/70 mt-2" x-text="tmpl.description"></p>
						</button>
					</template>
					<button
						@click="pickBlank()"
						type="button"
						class="text-left border border-dashed border-base-300 hover:border-primary rounded-box p-4 transition-colors"
					>
						<p class="font-medium text-sm">Blank</p>
						<p class="text-xs text-base-content/70 mt-2">Configure everything yourself.</p>
					</button>
				</div>
			</div>
			<div class="modal-backdrop" @click="showTemplateModal = false"></div>
		</div>
	</template>
}

templ agentSkillInstallModal() {
	<template x-if="skillInstallModalOpen">
		<div class="modal modal-open">
			<div class="modal-box w-11/12 max-w-5xl p-0 overflow-hidden">
				<div class="border-b border-base-300 px-6 py-5 flex items-start justify-between gap-4">
					<div class="space-y-1">
						<h3 class="font-bold text-xl">Add a skill</h3>
						<p class="text-sm text-base-content/60">Install from the catalog or upload your own skill bundle.</p>
					</div>
					<button @click="skillInstallModalOpen = false" class="btn btn-ghost btn-sm btn-circle shrink-0">✕</button>
				</div>
				<div class="px-6 py-4 border-b border-base-300 space-y-2 bg-base-200/30">
					<label class="text-xs font-medium text-secondary block uppercase tracking-wide">Install target</label>
					<div class="flex items-center gap-2 flex-wrap">
						<button @click="setSkillInstallScope('agent')" x-show="canInstallAgentSkills()" type="button" class="btn btn-sm" :class="skillInstallScope === 'agent' ? 'btn-primary' : 'btn-ghost'">Only this agent</button>
						<button @click="setSkillInstallScope('user')" type="button" class="btn btn-sm" :class="skillInstallScope === 'user' ? 'btn-primary' : 'btn-ghost'">My profile</button>
					</div>
					<p x-show="!canInstallAgentSkills()" class="text-xs text-base-content/50">Agent-only install is available after the agent is saved, and only for admins.</p>
				</div>
				<div class="grid grid-cols-1 xl:grid-cols-[minmax(0,1.3fr)_minmax(320px,0.9fr)] gap-0">
					<section class="p-6 min-w-0 xl:border-r border-base-300 space-y-4">
						<div class="space-y-1">
							<h4 class="font-medium text-base">Browse catalog</h4>
							<p class="text-sm text-base-content/60">Search public skills and install in one click.</p>
						</div>
						<input
							x-model="skillSearchQuery"
							@input.debounce.300ms="doSkillSearch()"
							type="text"
							placeholder="Search skills..."
							class="input input-bordered w-full"
							autofocus
						/>
						<template x-if="skillSearching">
							<div class="py-10 text-center"><span class="loading loading-spinner loading-md"></span></div>
						</template>
						<template x-if="!skillSearching && skillSearchResults.length > 0">
							<div class="space-y-3 max-h-[28rem] overflow-y-auto pr-1">
								<template x-for="s in skillSearchResults" :key="s.id">
									<div class="rounded-box border border-base-300 bg-base-100 px-4 py-4 space-y-3">
										<div class="flex items-start justify-between gap-3">
											<div class="min-w-0">
												<div class="flex items-center gap-2 flex-wrap">
													<p class="font-mono text-sm font-medium truncate" x-text="s.name || s.skillId"></p>
													<span class="badge badge-ghost badge-xs" x-text="s.installs + ' installs'"></span>
												</div>
												<p class="text-xs text-base-content/50 font-mono truncate mt-1" x-text="s.source + '@' + s.skillId"></p>
											</div>
											<button @click="installSkillResult(s)" :disabled="skillInstalling" type="button" class="btn btn-primary btn-sm shrink-0">
												<span x-show="skillInstalling && skillInstallSource === (s.source + '@' + s.skillId)" class="loading loading-spinner loading-xs"></span>
												Install
											</button>
										</div>
										<p x-show="s.description" class="text-sm text-base-content/70" x-text="s.description"></p>
									</div>
								</template>
							</div>
						</template>
						<template x-if="!skillSearching && skillSearchResults.length === 0 && skillSearchQuery">
							<div class="rounded-box border border-dashed border-base-300 p-8 text-center text-sm text-base-content/60">No skills found for that search.</div>
						</template>
						<template x-if="!skillSearching && !skillSearchQuery">
							<div class="rounded-box border border-dashed border-base-300 p-8 text-center text-sm text-base-content/60">Start typing to search the catalog.</div>
						</template>
					</section>
					<section class="p-6 space-y-4 bg-base-200/20">
						<div class="space-y-1">
							<h4 class="font-medium text-base">Upload zip</h4>
							<p class="text-sm text-base-content/60">Import a skill you already have on disk.</p>
						</div>
						<label class="block rounded-box border-2 border-dashed border-base-300 bg-base-100 px-5 py-8 text-center cursor-pointer hover:border-primary transition-colors">
							<input @change="setSkillUploadFile($event)" type="file" accept=".zip,application/zip" class="hidden"/>
							<div class="space-y-2">
								<div class="text-sm font-medium" x-text="skillUploadFile ? skillUploadFile.name : 'Choose a .zip file'"></div>
								<p class="text-xs text-base-content/60">Must contain exactly one skill folder with <span class="font-mono">SKILL.md</span>.</p>
								<span class="btn btn-ghost btn-sm">Browse files</span>
							</div>
						</label>
						<ul class="text-xs text-base-content/60 space-y-1 list-disc pl-4">
							<li><span class="font-mono">.zip</span> only</li>
							<li>Single skill folder</li>
							<li><span class="font-mono">SKILL.md</span> required</li>
						</ul>
						<button @click="doSkillUpload()" :disabled="skillUploading || !skillUploadFile" type="button" class="btn btn-primary w-full">
							<span x-show="skillUploading" class="loading loading-spinner loading-xs"></span>
							Upload skill
						</button>
					</section>
				</div>
			</div>
			<div class="modal-backdrop" @click="skillInstallModalOpen = false"></div>
		</div>
	</template>
}

templ agentConfirmDialog() {
	<div x-show="confirmMsg" x-cloak class="fixed inset-0 z-50 flex items-center justify-center bg-black/40">
		<div class="card bg-base-100 shadow-xl w-full max-w-sm" @click.away="confirmMsg = ''">
			<div class="card-body">
				<p class="text-sm" x-text="confirmMsg"></p>
				<div class="card-actions justify-end mt-4">
					<button @click="confirmMsg = ''" class="btn btn-ghost btn-sm">Cancel</button>
					<button @click="confirmAction(); confirmMsg = ''" class="btn btn-error btn-sm">Delete</button>
				</div>
			</div>
		</div>
	</div>
}
