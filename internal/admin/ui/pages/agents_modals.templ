package pages

templ agentTemplateModal() {
	<template x-if="showTemplateModal">
		<div class="modal modal-open">
			<div class="modal-box w-11/12 max-w-2xl">
				<div class="flex items-center justify-between mb-4">
					<h3 class="font-bold text-lg">Start from a template</h3>
					<button @click="showTemplateModal = false" class="btn btn-ghost btn-sm btn-circle">✕</button>
				</div>
				<p class="text-sm text-base-content/60 mb-4">Templates pre-fill the system prompt, skills, and model. You can edit everything before saving.</p>
				<div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
					<template x-for="tmpl in builtinTemplates" :key="tmpl.id">
						<button
							@click="pickTemplate(tmpl)"
							type="button"
							class="text-left border border-base-300 hover:border-primary rounded-box p-4 transition-colors"
						>
							<p class="font-medium text-sm" x-text="tmpl.name"></p>
							<p class="text-xs text-secondary font-mono mt-0.5" x-text="tmpl.id"></p>
							<p class="text-xs text-base-content/70 mt-2" x-text="tmpl.description"></p>
						</button>
					</template>
					<button
						@click="pickBlank()"
						type="button"
						class="text-left border border-dashed border-base-300 hover:border-primary rounded-box p-4 transition-colors"
					>
						<p class="font-medium text-sm">Blank</p>
						<p class="text-xs text-base-content/70 mt-2">Configure everything yourself.</p>
					</button>
				</div>
			</div>
			<div class="modal-backdrop" @click="showTemplateModal = false"></div>
		</div>
	</template>
}

templ agentSkillInstallModal() {
	<template x-if="skillInstallModalOpen">
		<div class="modal modal-open">
			<div class="modal-box w-11/12 max-w-2xl">
				<template x-if="skillInstallStage === 'search' || skillInstallStage === 'upload'">
					<div class="space-y-4">
						<div class="flex items-center justify-between">
							<h3 class="font-bold text-lg">Add skill</h3>
							<button @click="skillInstallModalOpen = false" class="btn btn-ghost btn-sm btn-circle">✕</button>
						</div>
						<div class="space-y-2">
							<label class="text-xs font-medium text-secondary block">Install target</label>
							<div class="flex items-center gap-2 flex-wrap">
								<button @click="setSkillInstallScope('agent')" x-show="canInstallAgentSkills()" type="button" class="badge badge-sm cursor-pointer" :class="skillInstallScope === 'agent' ? 'badge-primary' : 'badge-ghost'">Only this agent</button>
								<button @click="setSkillInstallScope('user')" type="button" class="badge badge-sm cursor-pointer" :class="skillInstallScope === 'user' ? 'badge-primary' : 'badge-ghost'">My profile</button>
							</div>
							<p x-show="!canInstallAgentSkills()" class="text-xs text-base-content/50">Agent-only install is available after the agent is saved, and only for admins.</p>
						</div>
						<div class="tabs tabs-boxed w-fit">
							<button @click="skillInstallStage = 'search'" type="button" class="tab" :class="skillInstallStage === 'search' ? 'tab-active' : ''">Search catalog</button>
							<button @click="skillInstallStage = 'upload'" type="button" class="tab" :class="skillInstallStage === 'upload' ? 'tab-active' : ''">Upload zip</button>
						</div>
						<template x-if="skillInstallStage === 'search'">
							<div class="space-y-4">
								<input
									x-model="skillSearchQuery"
									@input.debounce.300ms="doSkillSearch()"
									type="text"
									placeholder="Search skills..."
									class="input input-bordered w-full"
									autofocus
								/>
								<template x-if="skillSearching">
									<div class="py-6 text-center"><span class="loading loading-spinner loading-md"></span></div>
								</template>
								<template x-if="!skillSearching && skillSearchResults.length > 0">
									<div class="border border-base-300 rounded-lg overflow-y-auto max-h-72 divide-y divide-base-200">
										<template x-for="s in skillSearchResults" :key="s.id">
											<div class="px-4 py-3 cursor-pointer hover:bg-base-200/50 transition-colors" @click="pickSkillResult(s)">
												<div class="flex items-center justify-between gap-2">
													<span class="font-mono text-sm font-medium" x-text="s.name || s.skillId"></span>
													<span class="badge badge-ghost badge-xs shrink-0" x-text="s.installs + ' installs'"></span>
												</div>
												<p class="text-xs text-base-content/50 font-mono truncate mt-0.5" x-text="s.source + '@' + s.skillId"></p>
												<p x-show="s.description" class="text-xs text-base-content/70 truncate mt-0.5" x-text="s.description"></p>
											</div>
										</template>
									</div>
								</template>
								<template x-if="!skillSearching && skillSearchResults.length === 0 && skillSearchQuery">
									<p class="text-sm text-secondary text-center py-4">No skills found.</p>
								</template>
							</div>
						</template>
						<template x-if="skillInstallStage === 'upload'">
							<div class="space-y-3">
								<input @change="setSkillUploadFile($event)" type="file" accept=".zip,application/zip" class="file-input file-input-bordered w-full"/>
								<p class="text-xs text-base-content/60">Upload a .zip that contains exactly one skill folder with SKILL.md and any supporting files.</p>
								<div class="flex justify-end">
									<button @click="doSkillUpload()" :disabled="skillUploading || !skillUploadFile" type="button" class="btn btn-primary btn-sm">
										<span x-show="skillUploading" class="loading loading-spinner loading-xs"></span>
										Upload
									</button>
								</div>
							</div>
						</template>
					</div>
				</template>
				<template x-if="skillInstallStage === 'config'">
					<div class="space-y-4">
						<div class="flex items-center justify-between">
							<h3 class="font-bold text-lg">Confirm install</h3>
							<button @click="skillInstallModalOpen = false" class="btn btn-ghost btn-sm btn-circle">✕</button>
						</div>
						<div>
							<label class="text-xs font-medium text-secondary block mb-1">Source</label>
							<div class="bg-base-200/50 border border-base-300 rounded-lg px-3 py-2 font-mono text-sm text-base-content/70" x-text="skillInstallSource"></div>
						</div>
						<p class="text-xs text-base-content/60" x-text="skillInstallScope === 'agent' ? 'Add only to this agent.' : 'Add to your profile so it is available across agents.'"></p>
						<div class="flex gap-2 justify-end">
							<button @click="skillInstallStage = 'search'" class="btn btn-ghost btn-sm">Back</button>
							<button @click="doSkillInstall()" :disabled="skillInstalling" class="btn btn-primary btn-sm">
								<span x-show="skillInstalling" class="loading loading-spinner loading-xs"></span>
								Install
							</button>
						</div>
					</div>
				</template>
			</div>
			<div class="modal-backdrop" @click="skillInstallModalOpen = false"></div>
		</div>
	</template>
}

templ agentConfirmDialog() {
	<div x-show="confirmMsg" x-cloak class="fixed inset-0 z-50 flex items-center justify-center bg-black/40">
		<div class="card bg-base-100 shadow-xl w-full max-w-sm" @click.away="confirmMsg = ''">
			<div class="card-body">
				<p class="text-sm" x-text="confirmMsg"></p>
				<div class="card-actions justify-end mt-4">
					<button @click="confirmMsg = ''" class="btn btn-ghost btn-sm">Cancel</button>
					<button @click="confirmAction(); confirmMsg = ''" class="btn btn-error btn-sm">Delete</button>
				</div>
			</div>
		</div>
	</div>
}
