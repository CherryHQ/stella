package pages

import "github.com/vaayne/anna/internal/admin/ui"

templ PluginsPage() {
	<div x-data="pluginsPage()">
		@ui.PageHeader("Plugins", "Manage built-in tools, hooks, channels, memory backends, and standalone services.")
		<div class="space-y-8">
			<!-- Tools -->
			<div>
				<h3 class="text-base font-medium mb-3">Tools</h3>
				<div class="border border-base-300 rounded-lg divide-y divide-base-300">
					<template x-for="p in toolPlugins" :key="p.id">
						<div>
							<div class="flex items-center justify-between px-4 py-3">
								<div class="flex items-center gap-3">
									<span class="font-mono font-medium text-sm" x-text="p.name"></span>
									<span class="badge badge-ghost badge-sm">tool</span>
									<template x-if="p.enabled">
										<span class="badge badge-success badge-sm">enabled</span>
									</template>
									<template x-if="!p.enabled">
										<span class="badge badge-error badge-sm">disabled</span>
									</template>
								</div>
								<div class="flex items-center gap-4">
									<span class="text-xs text-secondary hidden sm:inline" x-text="descriptionFor(p.name)"></span>
									<input
										type="checkbox"
										:checked="p.enabled"
										@change="togglePlugin(p.id, $event.target.checked)"
										class="toggle toggle-primary toggle-sm"
									/>
								</div>
							</div>
							<template x-if="p.name === 'mcp'">
								<div class="px-4 pb-4 border-t border-base-300 bg-base-100/50">
									<div class="flex items-center justify-between pt-4 mb-3">
										<div>
											<p class="text-sm font-medium">MCP servers</p>
											<p class="text-xs text-secondary">Admins configure multiple MCP servers here. Save updates the JSON plugin config and reconciles the runtime.</p>
										</div>
										<div class="flex gap-2">
											<button @click="addMcpServer()" class="btn btn-ghost btn-xs">Add server</button>
											<button @click="saveMcpConfig()" class="btn btn-primary btn-xs">Save MCP config</button>
										</div>
									</div>
									<div class="space-y-4">
										<template x-for="(server, index) in mcpServers" :key="index">
											<div class="rounded-lg border border-base-300 p-4 bg-base-200/40 space-y-3">
												<div class="flex items-center justify-between gap-3">
													<div class="grid grid-cols-1 sm:grid-cols-3 gap-3 flex-1">
														<input x-model="server.name" type="text" placeholder="server name" class="input input-bordered input-sm w-full" />
														<select x-model="server.transport" class="select select-bordered select-sm w-full">
															<option value="stdio">stdio</option>
															<option value="sse">sse</option>
															<option value="streamable_http">streamable_http</option>
															<option value="http">http</option>
														</select>
														<label class="label cursor-pointer justify-start gap-2"><input x-model="server.enabled" type="checkbox" class="toggle toggle-primary toggle-sm" /> <span class="label-text text-sm">enabled</span></label>
													</div>
													<button @click="removeMcpServer(index)" class="btn btn-ghost btn-xs text-error">Remove</button>
												</div>
												<div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
													<input x-model="server.command" type="text" placeholder="command for stdio" class="input input-bordered input-sm w-full" />
													<input x-model="server.url" type="text" placeholder="URL for HTTP/SSE transports" class="input input-bordered input-sm w-full" />
													<input x-model.number="server.timeout_seconds" type="number" min="0" placeholder="timeout seconds" class="input input-bordered input-sm w-full" />
													<input x-model="server.args_text" type="text" placeholder='args JSON, e.g. ["-y","server"]' class="input input-bordered input-sm w-full" />
												</div>
												<div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
													<textarea x-model="server.env_text" rows="3" class="textarea textarea-bordered textarea-sm w-full font-mono" placeholder='env JSON, e.g. {"TOKEN":"..."}'></textarea>
													<textarea x-model="server.headers_text" rows="3" class="textarea textarea-bordered textarea-sm w-full font-mono" placeholder='headers JSON, e.g. {"Authorization":"Bearer ..."}'></textarea>
												</div>
											</div>
										</template>
										<template x-if="mcpServers.length === 0">
											<div class="text-xs text-secondary py-2">No MCP servers configured yet.</div>
										</template>
									</div>
								</div>
							</template>
						</div>
					</template>
					<template x-if="toolPlugins.length === 0">
						<div class="px-4 py-8 text-center text-base-content/50 text-sm">No tool plugins</div>
					</template>
				</div>
			</div>
			<!-- Hooks -->
			<div>
				<h3 class="text-base font-medium mb-3">Hooks</h3>
				<div class="border border-base-300 rounded-lg divide-y divide-base-300">
					<template x-for="p in hookPlugins" :key="p.id">
						<div class="flex items-center justify-between px-4 py-3">
							<div class="flex items-center gap-3">
								<span class="font-mono font-medium text-sm" x-text="p.name"></span>
								<span class="badge badge-warning badge-sm">hook</span>
								<template x-if="p.enabled">
									<span class="badge badge-success badge-sm">enabled</span>
								</template>
								<template x-if="!p.enabled">
									<span class="badge badge-error badge-sm">disabled</span>
								</template>
							</div>
							<div class="flex items-center gap-4">
								<span class="text-xs text-secondary hidden sm:inline" x-text="descriptionFor(p.name)"></span>
								<input
									type="checkbox"
									:checked="p.enabled"
									@change="togglePlugin(p.id, $event.target.checked)"
									class="toggle toggle-primary toggle-sm"
								/>
							</div>
						</div>
					</template>
					<template x-if="hookPlugins.length === 0">
						<div class="px-4 py-8 text-center text-base-content/50 text-sm">No hook plugins</div>
					</template>
				</div>
			</div>
			<!-- Channels -->
			<div>
				<h3 class="text-base font-medium mb-3">Channels</h3>
				<div class="border border-base-300 rounded-lg divide-y divide-base-300">
					<template x-for="p in channelPlugins" :key="p.id">
						<div class="flex items-center justify-between px-4 py-3">
							<div class="flex items-center gap-3">
								<span class="font-mono font-medium text-sm" x-text="p.name"></span>
								<span class="badge badge-info badge-sm">channel</span>
								<template x-if="p.enabled">
									<span class="badge badge-success badge-sm">enabled</span>
								</template>
								<template x-if="!p.enabled">
									<span class="badge badge-error badge-sm">disabled</span>
								</template>
							</div>
							<div class="flex items-center gap-4">
								<span class="text-xs text-secondary hidden sm:inline" x-text="descriptionFor(p.name)"></span>
								<input
									type="checkbox"
									:checked="p.enabled"
									@change="togglePlugin(p.id, $event.target.checked)"
									class="toggle toggle-primary toggle-sm"
								/>
							</div>
						</div>
					</template>
					<template x-if="channelPlugins.length === 0">
						<div class="px-4 py-8 text-center text-base-content/50 text-sm">No channel plugins</div>
					</template>
				</div>
			</div>
			<!-- Memory -->
			<div>
				<h3 class="text-base font-medium mb-3">Memory</h3>
				<p class="text-xs text-base-content/50 mb-3">Only one memory plugin can be active at a time. Changing requires restart.</p>
				<div class="border border-base-300 rounded-lg divide-y divide-base-300">
					<template x-for="p in memoryPlugins" :key="p.id">
						<div class="flex items-center justify-between px-4 py-3">
							<div class="flex items-center gap-3">
								<span class="font-mono font-medium text-sm" x-text="p.name"></span>
								<span class="badge badge-accent badge-sm">memory</span>
								<template x-if="p.enabled">
									<span class="badge badge-success badge-sm">enabled</span>
								</template>
								<template x-if="!p.enabled">
									<span class="badge badge-error badge-sm">disabled</span>
								</template>
							</div>
							<div class="flex items-center gap-4">
								<span class="text-xs text-secondary hidden sm:inline" x-text="descriptionFor(p.name)"></span>
								<input
									type="checkbox"
									:checked="p.enabled"
									@change="togglePlugin(p.id, $event.target.checked)"
									class="toggle toggle-primary toggle-sm"
								/>
							</div>
						</div>
					</template>
					<template x-if="memoryPlugins.length === 0">
						<div class="px-4 py-8 text-center text-base-content/50 text-sm">No memory plugins</div>
					</template>
				</div>
			</div>
			<!-- Standalone -->
			<div x-show="standalonePlugins.length > 0">
				<h3 class="text-base font-medium mb-3">Standalone</h3>
				<p class="text-xs text-base-content/50 mb-3">Background services that run independently. Toggling takes effect immediately.</p>
				<div class="border border-base-300 rounded-lg divide-y divide-base-300">
					<template x-for="p in standalonePlugins" :key="p.id">
						<div class="flex items-center justify-between px-4 py-3">
							<div class="flex items-center gap-3">
								<span class="font-mono font-medium text-sm" x-text="p.name"></span>
								<span class="badge badge-neutral badge-sm" x-text="p.kind"></span>
								<template x-if="p.enabled">
									<span class="badge badge-success badge-sm">enabled</span>
								</template>
								<template x-if="!p.enabled">
									<span class="badge badge-error badge-sm">disabled</span>
								</template>
							</div>
							<div class="flex items-center gap-4">
								<span class="text-xs text-secondary hidden sm:inline" x-text="descriptionFor(p.name)"></span>
								<input
									type="checkbox"
									:checked="p.enabled"
									@change="togglePlugin(p.id, $event.target.checked)"
									class="toggle toggle-primary toggle-sm"
								/>
							</div>
						</div>
					</template>
				</div>
			</div>
		</div>
	</div>
}
