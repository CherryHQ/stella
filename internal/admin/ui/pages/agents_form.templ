package pages

import "github.com/vaayne/anna/internal/config"

templ agentFormPanel() {
	<div class="border border-base-300 rounded-box overflow-hidden">
		<div class="border-b border-base-300 px-4 py-3 bg-base-200/30">
			<span class="font-medium text-sm" x-text="editingId ? 'Edit: ' + form.name : 'New agent'"></span>
		</div>
		<div class="border-b border-base-300 px-2 flex overflow-x-auto bg-base-200/20">
			@agentFormTab("config", "Config")
			@agentFormTab("prompt", "Prompt")
			@agentFormTab("skills", "Skills")
			@agentFormTab("advanced", "Advanced")
			<button
				x-show="isAdmin"
				@click="activeTab = 'users'; loadAssignedUsers(editingId)"
				class="px-3 py-2.5 text-xs font-mono border-b-2 transition-colors whitespace-nowrap"
				:class="activeTab === 'users' ? 'border-primary text-primary font-semibold' : 'border-transparent text-secondary hover:text-base-content'"
			>Users</button>
			<button
				x-show="editingId"
				@click="activeTab = 'personal'"
				class="px-3 py-2.5 text-xs font-mono border-b-2 transition-colors whitespace-nowrap"
				:class="activeTab === 'personal' ? 'border-primary text-primary font-semibold' : 'border-transparent text-secondary hover:text-base-content'"
			>Personal</button>
		</div>
		<div class="p-4 space-y-4">
			<div x-show="activeTab === 'config'">
				@agentConfigTab()
			</div>
			<div x-show="activeTab === 'prompt'">
				@agentPromptTab()
			</div>
			<div x-show="activeTab === 'skills'">
				@agentSkillsTab()
			</div>
			<div x-show="activeTab === 'advanced'">
				@agentAdvancedTab()
			</div>
			<div x-show="activeTab === 'users'">
				@agentUsersTab()
			</div>
			<div x-show="activeTab === 'personal'">
				@agentPersonalTab()
			</div>
		</div>
		<div class="border-t border-base-300 px-4 py-3 flex items-center justify-end gap-2 bg-base-200/20">
			<button @click="cancelForm()" class="btn btn-ghost btn-sm">Cancel</button>
			<button @click="saveAgent()" class="btn btn-primary btn-sm" x-text="editingId ? 'Update' : 'Create'"></button>
		</div>
	</div>
}

templ agentFormTab(id string, label string) {
	<button
		@click={ "activeTab = '" + id + "'" }
		class="px-3 py-2.5 text-xs font-mono border-b-2 transition-colors whitespace-nowrap"
		:class={ "activeTab === '" + id + "' ? 'border-primary text-primary font-semibold' : 'border-transparent text-secondary hover:text-base-content'" }
	>{ label }</button>
}

templ agentConfigTab() {
	<div class="space-y-4">
		<div>
			<label class="label"><span class="label-text font-mono text-sm">Name</span></label>
			<input x-model="form.name" placeholder="My Agent" class="input input-bordered w-full text-sm"/>
		</div>
		<div>
			<p class="text-xs font-mono font-medium text-secondary uppercase tracking-wider mb-3">
				Models <span class="normal-case tracking-normal text-base-content/50">— provider/model</span>
			</p>
			<div class="space-y-3">
				@modelComboField("Default", "model", config.DefaultModelRefForProviderType("anthropic"))
				<div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
					@modelComboField("Strong", "model_strong", "Falls back to default")
					@modelComboField("Fast", "model_fast", "Falls back to default")
				</div>
			</div>
		</div>
		<div x-show="isAdmin">
			<label class="label"><span class="label-text font-mono text-sm">Scope</span></label>
			<select x-model="form.scope" class="select select-bordered w-full text-sm">
				<option value="system">system — all users can access</option>
				<option value="restricted">restricted — only assigned users</option>
			</select>
		</div>
		<div x-show="isAdmin && editingId">
			<label class="label"><span class="label-text font-mono text-sm">Dedicated channels</span></label>
			<p class="text-xs text-base-content/60 mb-2">Bind dedicated channel instances to this agent.</p>
			<div class="space-y-1">
				<template x-for="ch in availableDedicatedChannels(editingId)" :key="ch.id">
					<label class="flex items-center justify-between gap-3 rounded-lg border border-base-300 px-3 py-2 cursor-pointer">
						<div class="min-w-0">
							<p class="text-sm font-mono" x-text="ch.id"></p>
							<p class="text-xs text-secondary" x-text="ch.type"></p>
						</div>
						<input type="checkbox" :value="ch.id" x-model="selectedChannelIDs" class="checkbox checkbox-sm checkbox-primary"/>
					</label>
				</template>
				<div x-show="availableDedicatedChannels(editingId).length === 0" class="text-xs text-base-content/50">No dedicated channels available.</div>
			</div>
		</div>
		<div class="pt-2 border-t border-base-300">
			<label class="flex items-center gap-3 cursor-pointer">
				<input type="checkbox" x-model="form.enabled" class="toggle toggle-primary toggle-sm"/>
				<span class="text-sm">Enabled</span>
			</label>
		</div>
	</div>
}

templ agentPromptTab() {
	<div class="space-y-4">
		<div x-show="builtinSouls.length > 0">
			<label class="label"><span class="label-text font-mono text-sm">Soul preset</span></label>
			<div class="flex flex-wrap gap-2">
				<template x-for="soul in builtinSouls" :key="soul.id">
					<button
						@click="selectedSoulID = soul.id; applySoul(soul.id)"
						type="button"
						class="badge badge-sm cursor-pointer transition-colors"
						:class="selectedSoulID === soul.id ? 'badge-primary' : 'badge-ghost'"
						:title="soul.description"
						x-text="soul.name"
					></button>
				</template>
			</div>
		</div>
		<div>
			<label class="label"><span class="label-text font-mono text-sm">Soul</span></label>
			<p class="text-xs text-base-content/60 mb-1">Default personality for all users. Each user can override their own.</p>
			<textarea x-model="form.soul" rows="3" placeholder="Personality and behavior tone..." class="textarea textarea-bordered w-full text-sm font-mono resize-y"></textarea>
		</div>
		<div>
			<label class="label"><span class="label-text font-mono text-sm">System Prompt</span></label>
			<textarea
				x-model="form.system_prompt"
				rows="10"
				class="textarea textarea-bordered w-full text-sm font-mono resize-y"
				:disabled="editingId && !canEditAgent({creator_id: form.creator_id})"
			></textarea>
		</div>
	</div>
}

templ agentSkillsTab() {
	<div class="grid grid-cols-1 xl:grid-cols-[minmax(0,0.9fr)_minmax(0,1.1fr)] gap-4 min-w-0">
		<div class="border border-base-300 rounded-box bg-base-100/70 min-w-0 overflow-hidden">
			<div class="p-4 border-b border-base-300 space-y-3">
				<div class="flex flex-col gap-3 lg:flex-row lg:items-center lg:justify-between">
					<input
						x-model="skillListQuery"
						type="text"
						placeholder="Search skills..."
						class="input input-bordered input-sm w-full lg:max-w-sm"
					/>
					<div class="flex items-center gap-2 flex-wrap">
						<button @click="openSkillInstallModal()" type="button" class="btn btn-primary btn-sm">+ Install skill</button>
					</div>
				</div>
				<div class="flex items-center gap-2 flex-wrap">
					<button @click="skillViewFilter = 'all'" type="button" class="badge badge-sm cursor-pointer" :class="skillViewFilter === 'all' ? 'badge-primary' : 'badge-ghost'">All</button>
					<button @click="skillViewFilter = 'enabled'" type="button" class="badge badge-sm cursor-pointer" :class="skillViewFilter === 'enabled' ? 'badge-primary' : 'badge-ghost'">Enabled</button>
					<button @click="skillViewFilter = 'modified'" type="button" class="badge badge-sm cursor-pointer" :class="skillViewFilter === 'modified' ? 'badge-primary' : 'badge-ghost'">Modified</button>
				</div>
				<div class="flex items-center gap-2 flex-wrap">
					<button @click="skillScopeFilter = 'all'" type="button" class="badge badge-sm cursor-pointer" :class="skillScopeFilter === 'all' ? 'badge-accent' : 'badge-ghost'">Any scope</button>
					<button @click="skillScopeFilter = 'system'" type="button" class="badge badge-sm cursor-pointer" :class="skillScopeFilter === 'system' ? 'badge-accent' : 'badge-ghost'">Built-in</button>
					<button @click="skillScopeFilter = 'user'" type="button" class="badge badge-sm cursor-pointer" :class="skillScopeFilter === 'user' ? 'badge-accent' : 'badge-ghost'">User</button>
					<button @click="skillScopeFilter = 'agent'" type="button" class="badge badge-sm cursor-pointer" :class="skillScopeFilter === 'agent' ? 'badge-accent' : 'badge-ghost'">This agent</button>
				</div>
				<div x-show="!editingId" class="text-xs text-base-content/50">Save the agent first if you want to add or customize agent-specific skills.</div>
			</div>
			<div class="p-3 space-y-2 max-h-[70vh] overflow-y-auto min-w-0">
				<template x-if="agentSkillsLoading">
					<div class="py-4 flex justify-center"><span class="loading loading-spinner loading-sm"></span></div>
				</template>
				<template x-for="sk in filteredSkills()" :key="skillKey(sk)">
					<button
						@click="selectSkill(sk)"
						type="button"
						class="w-full text-left rounded-box border border-base-300 px-3 py-3 transition-colors hover:bg-base-200/50 overflow-hidden"
						:class="selectedSkillKey === skillKey(sk) ? 'border-primary bg-primary/5' : ''"
					>
						<div class="flex items-center gap-3 min-w-0">
							<input
								x-show="skillCanToggle(sk)"
								type="checkbox"
								class="toggle toggle-primary toggle-xs shrink-0"
								:checked="sk.status === 'active'"
								@click.stop="toggleSkillStatus(sk)"
								:title="sk.status === 'active' ? 'Disable skill' : 'Enable skill'"
							/>
							<span x-show="!skillCanToggle(sk)" class="badge badge-ghost badge-xs shrink-0">read only</span>
							<div class="min-w-0 flex-1 overflow-hidden">
								<div class="flex items-center gap-2 flex-wrap min-w-0">
									<p class="text-sm font-mono truncate min-w-0" x-text="sk.name"></p>
									<span class="badge badge-xs shrink-0" :class="skillScopeClass(sk.scope)" x-text="skillScopeLabel(sk.scope)"></span>
									<span class="badge badge-xs shrink-0" :class="skillStatusClass(sk.status)" x-text="sk.status === 'active' ? 'Enabled' : sk.status"></span>
								</div>
								<p x-show="sk.description" class="text-xs text-base-content/60 truncate mt-1" x-text="sk.description"></p>
							</div>
						</div>
					</button>
				</template>
				<div x-show="!agentSkillsLoading && filteredSkills().length === 0" class="text-xs text-base-content/50 p-2">No skills match this filter.</div>
			</div>
		</div>

		<div class="border border-base-300 rounded-box bg-base-100/70 min-w-0 overflow-hidden">
			<template x-if="!selectedSkill && !selectedSkillLoading">
				<div class="p-8 text-center text-sm text-base-content/50">Select a skill to inspect or edit.</div>
			</template>
			<template x-if="selectedSkillLoading">
				<div class="p-8 flex justify-center"><span class="loading loading-spinner loading-md"></span></div>
			</template>
			<template x-if="selectedSkill && !selectedSkillLoading">
				<div class="min-w-0">
					<div class="p-4 border-b border-base-300 flex flex-col gap-3 lg:flex-row lg:items-start lg:justify-between">
						<div class="min-w-0">
							<div class="flex items-center gap-2 flex-wrap">
								<h3 class="font-medium text-base min-w-0 truncate" x-text="selectedSkill.name"></h3>
								<span class="badge badge-xs" :class="skillScopeClass(selectedSkill.scope)" x-text="skillScopeLabel(selectedSkill.scope)"></span>
								<span class="badge badge-xs" :class="skillStatusClass(selectedSkill.status)" x-text="selectedSkill.status === 'active' ? 'Enabled' : selectedSkill.status"></span>
							</div>
							<p class="text-sm text-base-content/70 mt-2 break-words" x-text="selectedSkill.description || 'No description yet.'"></p>
							<p class="text-xs text-base-content/60 mt-2" x-text="selectedSkill.scope === 'system' ? 'Built-in skill. Read-only here; duplicate it to this agent if you want to customize behavior.' : (selectedSkill.scope === 'user' ? 'Installed on your profile and available across agents.' : 'Installed only on this agent.')"></p>
						</div>
						<div class="flex items-center gap-2 flex-wrap">
							<button x-show="selectedSkill.scope === 'system' && canInstallAgentSkills()" @click="duplicateSelectedBuiltinSkillToAgent()" type="button" class="btn btn-primary btn-xs">Duplicate to agent</button>
							<button x-show="skillCanEdit() && !selectedSkillEditMode" @click="startEditingSelectedSkill()" type="button" class="btn btn-ghost btn-xs">Edit</button>
							<button x-show="skillCanDelete()" @click="deleteSkill()" type="button" class="btn btn-ghost btn-xs text-error">Delete</button>
							<button x-show="skillCanEdit() && selectedSkillEditMode" @click="saveSelectedSkill()" type="button" class="btn btn-primary btn-xs" :disabled="selectedSkillSaving || !selectedSkillDirty">
								<span x-show="selectedSkillSaving" class="loading loading-spinner loading-xs"></span>
								Save
							</button>
							<button x-show="skillCanEdit() && selectedSkillEditMode" @click="stopEditingSelectedSkill()" type="button" class="btn btn-ghost btn-xs">Cancel</button>
						</div>
					</div>

					<div class="p-4 border-b border-base-300 grid grid-cols-1 md:grid-cols-2 gap-4">
						<div class="space-y-2">
							<p class="text-xs font-mono text-secondary uppercase tracking-wider">Status</p>
							<div x-show="!selectedSkillEditMode" class="text-sm" x-text="selectedSkill.status === 'active' ? 'Enabled' : selectedSkill.status"></div>
							<select x-show="selectedSkillEditMode" x-model="selectedSkill.status" @change="markSelectedSkillDirty()" class="select select-bordered select-sm w-full" :disabled="!skillCanEdit()">
								<option value="active">active</option>
								<option value="draft">draft</option>
								<option value="deprecated">deprecated</option>
							</select>
						</div>
						<div class="space-y-2">
							<p class="text-xs font-mono text-secondary uppercase tracking-wider">Scope</p>
							<div class="text-sm" x-text="skillScopeLabel(selectedSkill.scope)"></div>
							<label x-show="selectedSkillEditMode" class="flex items-center gap-2 cursor-pointer pt-1">
								<input x-model="selectedSkill.disable_model_invocation" @change="markSelectedSkillDirty()" :disabled="!skillCanEdit()" type="checkbox" class="toggle toggle-primary toggle-sm"/>
								<span class="text-xs">Disable model invocation</span>
							</label>
						</div>
					</div>

					<div x-show="selectedSkillEditMode" class="p-4 border-b border-base-300 space-y-3">
						<div>
							<label class="label"><span class="label-text text-xs font-medium">Description</span></label>
							<input x-model="selectedSkill.description" @input="markSelectedSkillDirty()" :disabled="!skillCanEdit()" type="text" class="input input-bordered input-sm w-full"/>
						</div>
					</div>

					<div class="p-4 border-b border-base-300">
						<button @click="selectedSkillShowAdvanced = !selectedSkillShowAdvanced" type="button" class="btn btn-ghost btn-sm px-0" x-text="selectedSkillShowAdvanced ? 'Hide advanced' : 'Show advanced'"></button>
						<p class="text-xs text-base-content/50 mt-2">Files and source editing live here so the main view stays focused on behavior.</p>
					</div>

					<div x-show="selectedSkillShowAdvanced" class="min-w-0">
						<div class="p-4 border-b border-base-300 space-y-2">
							<div class="flex items-center gap-2 flex-wrap">
								<select x-model="selectedSkillActiveFile" @change="selectSkillFile(selectedSkillActiveFile)" class="select select-bordered select-sm w-auto max-w-sm font-mono text-xs">
									<template x-for="file in selectedSkillFiles()" :key="file">
										<option :value="file" x-text="file"></option>
									</template>
								</select>
								<button x-show="skillCanEdit() && selectedSkillEditMode && selectedSkillActiveFile !== 'SKILL.md'" @click="deleteSelectedSkillFile(selectedSkillActiveFile)" type="button" class="btn btn-ghost btn-xs text-error">Delete file</button>
								<button x-show="skillCanEdit() && selectedSkillEditMode && !selectedSkillAddingFile" @click="confirmAddSkillFile()" type="button" class="btn btn-ghost btn-xs">+ Add file</button>
							</div>
							<div x-show="selectedSkillAddingFile" class="flex items-center gap-2">
								<input x-model="selectedSkillNewFileName" @keydown.enter.prevent="commitAddSkillFile()" @keydown.escape="selectedSkillAddingFile = false" type="text" placeholder="reference.md" class="input input-bordered input-xs flex-1 font-mono"/>
								<button @click="commitAddSkillFile()" type="button" class="btn btn-primary btn-xs">Add</button>
								<button @click="selectedSkillAddingFile = false" type="button" class="btn btn-ghost btn-xs">Cancel</button>
							</div>
						</div>

						<div class="p-4 min-w-0">
							<template x-if="selectedSkillFileLoading">
								<div class="py-8 flex justify-center"><span class="loading loading-spinner loading-sm"></span></div>
							</template>
							<template x-if="!selectedSkillFileLoading">
								<textarea
									x-model="selectedSkillFileContent"
									@input="markSelectedSkillDirty()"
									:disabled="!skillCanEdit() || !selectedSkillEditMode"
									rows="18"
									class="textarea textarea-bordered w-full text-xs font-mono resize-y"
									spellcheck="false"
								></textarea>
							</template>
						</div>
					</div>
				</div>
			</template>
		</div>
	</div>
}

templ agentAdvancedTab() {
	<div class="border border-base-300 rounded-box p-4 bg-base-200/40 space-y-4">
		<div>
			<p class="text-xs font-mono font-medium text-secondary uppercase tracking-wider mb-1">Network Policy</p>
			<p class="text-xs text-base-content/60">Sandbox backend is configured on the <a href="/plugins" class="link link-primary">Plugins</a> page.</p>
		</div>
		<div>
			<label class="label"><span class="label-text font-mono text-sm">Network Mode</span></label>
			<select x-model="form.sandbox.network.mode" class="select select-bordered w-full text-sm">
				<option value="disabled">disabled — block outbound network</option>
				<option value="allow_all">allow_all — allow outbound network</option>
				<option value="whitelist">whitelist — only listed hosts/CIDRs</option>
			</select>
		</div>
		<div x-show="form.sandbox.network.mode === 'whitelist'">
			<label class="label"><span class="label-text font-mono text-sm">Allowlist</span></label>
			<textarea
				:disabled="form.sandbox.network.mode !== 'whitelist'"
				:placeholder="'api.github.com&#10;pypi.org&#10;10.0.0.0/8'"
				:value="sandboxAllowlistText()"
				@input="updateSandboxAllowlist($event.target.value)"
				rows="4"
				class="textarea textarea-bordered w-full text-sm font-mono resize-y"
			></textarea>
			<p class="mt-1 text-xs text-warning">Runtime whitelist support depends on your sandbox backend version.</p>
		</div>
	</div>
}

templ agentUsersTab() {
	<div class="space-y-4">
		<p class="text-xs text-base-content/60">Manage user access for restricted-scope agents.</p>
		<div class="divide-y divide-base-300">
			<template x-for="u in assignedUsers" :key="u.id">
				<div class="flex items-center justify-between py-2">
					<span class="text-sm font-mono" x-text="u.username"></span>
					<button @click="removeUser(u.id)" class="btn btn-ghost btn-xs text-error">remove</button>
				</div>
			</template>
			<div x-show="assignedUsers.length === 0" class="text-xs text-base-content/50 py-2">No users assigned.</div>
		</div>
		<div class="flex gap-2">
			<select x-model="addUserId" class="select select-bordered select-sm flex-1">
				<option value="">Select user...</option>
				<template x-for="u in availableUsers" :key="u.id">
					<option :value="u.id" x-text="u.username"></option>
				</template>
			</select>
			<button @click="addUser()" class="btn btn-primary btn-sm" :disabled="!addUserId">Add</button>
		</div>
	</div>
}

templ agentPersonalTab() {
	<div class="space-y-6">
		<div x-show="!personalisation.loaded" class="flex justify-center py-4">
			<span class="loading loading-spinner loading-sm"></span>
		</div>
		<div x-show="personalisation.loaded" class="space-y-6">
			<div>
				<label class="label"><span class="label-text font-mono text-sm">Soul override</span></label>
				<p class="text-xs text-base-content/60 mb-1">Your personal soul for this agent. Replaces the agent default for your sessions only.</p>
				<textarea
					x-model="personalisation.soulDraft"
					rows="3"
					placeholder="Customise this agent's personality for yourself..."
					class="textarea textarea-bordered w-full text-sm font-mono resize-y"
				></textarea>
				<button
					@click="savePersonalisationSoul()"
					:disabled="personalisation.soulDraft === personalisation.soul"
					class="btn btn-ghost btn-xs text-primary disabled:opacity-30 mt-1"
				>Save</button>
			</div>
			<div>
				<label class="label"><span class="label-text font-mono text-sm">User profile</span></label>
				<p class="text-xs text-base-content/60 mb-1">What this agent knows about you across conversations.</p>
				<textarea
					x-model="personalisation.profileDraft"
					rows="3"
					placeholder="Add context about yourself for this agent..."
					class="textarea textarea-bordered w-full text-sm font-mono resize-y"
				></textarea>
				<button
					@click="savePersonalisationProfile()"
					:disabled="personalisation.profileDraft === personalisation.profile"
					class="btn btn-ghost btn-xs text-primary disabled:opacity-30 mt-1"
				>Save</button>
			</div>
		</div>
	</div>
}

templ modelComboField(label string, field string, placeholder string) {
	<div x-data="{ open: false, search: '' }" class="relative">
		<label class="label">
			<span class="label-text font-mono text-sm">{ label }</span>
			if field != "model" {
				<span class="label-text-alt text-base-content/40">(optional)</span>
			}
		</label>
		<input
			type="text"
			:value={ "form." + field }
			@input={ "form." + field + " = $event.target.value; search = $event.target.value; open = cachedModels.length > 0" }
			@focus="search = ''; open = cachedModels.length > 0"
			placeholder={ placeholder }
			class="input input-bordered w-full text-sm font-mono"
		/>
		<div
			x-show="open && filteredModels(search).length > 0"
			@click.away="open = false"
			x-transition.opacity
			x-cloak
			class="absolute z-20 mt-1 w-full max-h-48 overflow-y-auto bg-base-100 border border-base-300 rounded-box shadow-lg py-1"
		>
			<template x-for="m in filteredModels(search)" :key="m">
				<button
					@click={ "form." + field + " = m; open = false" }
					type="button"
					class="w-full text-left px-3 py-1.5 text-xs font-mono hover:bg-base-200 cursor-pointer"
					:class={ "form." + field + " === m ? 'text-primary' : 'text-base-content/70'" }
					x-text="m"
				></button>
			</template>
		</div>
	</div>
}
