package pages

import "github.com/vaayne/anna/internal/admin/ui"

templ UsersPage() {
	<div x-data="usersPage()">
		@ui.PageHeader("User management", "Manage auth users, roles, agent assignments, and linked identities.")
		<!-- Tabs: Auth Users / Legacy Memory -->
		<div class="flex gap-4 border-b border-base-300 mb-6">
			<button
				@click="tab = 'auth'"
				class="pb-2 text-sm font-medium transition-colors border-b-2"
				:class="tab === 'auth' ? 'border-primary text-primary' : 'border-transparent text-secondary hover:text-base-content'"
			>Auth Users</button>
			<button
				@click="tab = 'memory'"
				class="pb-2 text-sm font-medium transition-colors border-b-2"
				:class="tab === 'memory' ? 'border-primary text-primary' : 'border-transparent text-secondary hover:text-base-content'"
			>User Memory</button>
		</div>
		<!-- Auth Users Tab -->
		<div x-show="tab === 'auth'" x-cloak>
			<div class="text-xs font-mono text-secondary mb-4" x-text="authUsers.length + ' users'"></div>
			<!-- User list -->
			<div class="border-t border-base-300 divide-y divide-base-300">
				<template x-for="u in authUsers" :key="u.id">
					<div class="py-4">
						<div class="flex items-center justify-between">
							<div class="flex items-center gap-3">
								<button
									@click="selectUser(u)"
									class="font-medium hover:text-primary transition-colors cursor-pointer"
									x-text="u.username"
								></button>
								<span class="text-xs font-mono text-secondary" x-text="'#' + u.id"></span>
								<template x-for="role in u.roles" :key="role">
									<span
										class="badge badge-sm"
										:class="role === 'admin' ? 'badge-primary' : 'badge-ghost'"
										x-text="role"
									></span>
								</template>
								<span
									x-show="!u.is_active"
									class="badge badge-sm badge-error"
								>inactive</span>
							</div>
							<div class="flex items-center gap-2">
								<span class="text-xs text-secondary" x-text="u.created_at"></span>
							</div>
						</div>
						<!-- Linked identities summary -->
						<div class="mt-1 flex items-center gap-2" x-show="u.identities && u.identities.length > 0">
							<span class="text-xs text-secondary">Linked:</span>
							<template x-for="ident in u.identities" :key="ident.id">
								<span class="badge badge-ghost badge-xs font-mono uppercase" x-text="ident.platform"></span>
							</template>
						</div>
					</div>
				</template>
			</div>
			<!-- Empty state -->
			<div x-show="authUsers.length === 0" x-cloak>
				@ui.EmptyState("No users registered yet.")
			</div>
		</div>
		<!-- User Detail Panel -->
		<div x-show="selectedUser" x-cloak class="fixed inset-0 z-50 flex items-end sm:items-center justify-center bg-black/40">
			<div class="card bg-base-100 shadow-xl w-full max-w-lg max-h-[90vh] overflow-y-auto" @click.away="selectedUser = null">
				<div class="card-body">
					<div class="flex items-center justify-between mb-4">
						<h3 class="font-semibold text-lg" x-text="selectedUser?.username"></h3>
						<button @click="selectedUser = null" class="btn btn-ghost btn-sm btn-circle">✕</button>
					</div>
					<!-- Status + Actions -->
					<div class="flex items-center gap-3 mb-4">
						<span
							class="badge"
							:class="selectedUser?.is_active ? 'badge-success' : 'badge-error'"
							x-text="selectedUser?.is_active ? 'Active' : 'Inactive'"
						></span>
						<button
							@click="toggleActive()"
							class="btn btn-ghost btn-xs"
							:class="selectedUser?.is_active ? 'text-error' : 'text-success'"
							x-text="selectedUser?.is_active ? 'Deactivate' : 'Activate'"
						></button>
					</div>
					<!-- Roles Section -->
					<div class="mb-4">
						<p class="text-xs font-mono font-medium text-secondary uppercase tracking-wider mb-2">Roles</p>
						<div class="flex items-center gap-2 flex-wrap">
							<template x-for="role in selectedUser?.roles || []" :key="role">
								<span
									class="badge"
									:class="role === 'admin' ? 'badge-primary' : 'badge-ghost'"
									x-text="role"
								></span>
							</template>
							<template x-if="selectedUser && !selectedUser.roles?.includes('admin')">
								<button
									@click="toggleAdminRole('assign')"
									class="btn btn-ghost btn-xs text-primary"
								>+ admin</button>
							</template>
							<template x-if="selectedUser && selectedUser.roles?.includes('admin')">
								<button
									@click="toggleAdminRole('remove')"
									class="btn btn-ghost btn-xs text-error"
									:disabled="selectedUser?.id === currentUserId"
									:title="selectedUser?.id === currentUserId ? 'Cannot remove own admin role' : ''"
								>- admin</button>
							</template>
						</div>
					</div>
					<!-- Identities Section -->
					<div class="mb-4">
						<p class="text-xs font-mono font-medium text-secondary uppercase tracking-wider mb-2">Linked Identities</p>
						<div class="space-y-2">
							<template x-for="ident in selectedUser?.identities || []" :key="ident.id">
								<div class="flex items-center justify-between py-1 px-2 bg-base-200 rounded">
									<div class="flex items-center gap-2">
										<span class="badge badge-ghost badge-sm font-mono uppercase" x-text="ident.platform"></span>
										<span class="text-sm font-mono" x-text="ident.external_id"></span>
										<span class="text-xs text-secondary" x-show="ident.name" x-text="ident.name"></span>
									</div>
									<span class="text-xs text-secondary" x-text="ident.linked_at"></span>
								</div>
							</template>
							<div
								x-show="!selectedUser?.identities || selectedUser.identities.length === 0"
								class="text-xs text-secondary py-2"
							>No linked identities.</div>
						</div>
					</div>
					<!-- Agent Assignments Section -->
					<div class="mb-4">
						<p class="text-xs font-mono font-medium text-secondary uppercase tracking-wider mb-2">Agent Assignments</p>
						<div class="space-y-2">
							<template x-for="aid in userAgentIds" :key="aid">
								<div class="flex items-center justify-between py-1 px-2 bg-base-200 rounded">
									<span class="text-sm font-mono" x-text="aid"></span>
									<button
										@click="removeAgentFromUser(aid)"
										class="btn btn-ghost btn-xs text-error"
									>remove</button>
								</div>
							</template>
							<div
								x-show="userAgentIds.length === 0"
								class="text-xs text-secondary py-2"
							>No agent assignments (has access to all system-scope agents).</div>
						</div>
						<!-- Add agent -->
						<div class="mt-3 flex gap-2">
							<select x-model="addAgentId" class="select select-bordered select-sm flex-1">
								<option value="">Select agent...</option>
								<template x-for="a in availableAgents" :key="a.id">
									<option :value="a.id" x-text="a.name + ' (' + a.id + ')'"></option>
								</template>
							</select>
							<button @click="addAgentToUser()" class="btn btn-primary btn-sm" :disabled="!addAgentId">Add</button>
						</div>
					</div>
					<!-- Metadata -->
					<div class="text-xs text-secondary space-y-1 pt-2 border-t border-base-300">
						<p x-text="'Created: ' + (selectedUser?.created_at || '')"></p>
						<p x-text="'Updated: ' + (selectedUser?.updated_at || '')"></p>
					</div>
				</div>
			</div>
		</div>
		<!-- Memory Tab (legacy settings_users) -->
		<div x-show="tab === 'memory'" x-cloak>
			<div class="text-xs font-mono text-secondary mb-4" x-text="legacyUsers.length + ' users'"></div>
			<div class="border-t border-base-300 divide-y divide-base-300">
				<template x-for="u in legacyUsers" :key="u.id">
					<div class="py-6">
						<!-- User header -->
						<div class="flex items-baseline justify-between mb-3">
							<div class="flex items-baseline gap-3">
								<span class="font-medium" x-text="u.name || 'Unnamed'"></span>
								<span class="badge badge-ghost badge-sm font-mono uppercase" x-text="u.platform"></span>
							</div>
							<span class="text-xs font-mono text-secondary" x-text="'#' + u.id + ' · ' + u.external_id"></span>
						</div>
						<!-- Default agent -->
						<div class="flex items-center gap-3 mb-3">
							<span class="text-xs font-mono font-medium text-secondary uppercase tracking-wider shrink-0">Default Agent</span>
							<select x-model="u._defaultAgent" class="select select-bordered select-sm flex-1 text-sm">
								<option value="">None</option>
								<template x-for="a in agents" :key="a.id">
									<option :value="a.id" x-text="a.name + ' (' + a.id + ')'"></option>
								</template>
							</select>
							<button
								@click="saveUserDefaultAgent(u)"
								:disabled="u._defaultAgent === (u.default_agent_id || '')"
								class="btn btn-primary btn-sm disabled:opacity-30"
							>Save</button>
						</div>
						<!-- Memory toggle -->
						<button
							@click="toggleUserMemory(u)"
							class="text-xs text-secondary hover:text-primary transition-colors cursor-pointer flex items-center gap-1"
						>
							<span x-text="u._showMemory ? '▾' : '▸'"></span>
							<span>Memory</span>
							<span
								x-show="u._memoryCount > 0"
								class="font-mono text-primary"
								x-text="'(' + u._memoryCount + ')'"
							></span>
						</button>
						<!-- Memory section -->
						<div x-show="u._showMemory" x-transition x-cloak class="mt-4 pl-4 border-l-2 border-base-300 space-y-4">
							<!-- Memory list -->
							<template x-for="mem in (userMemories[u.id] || [])" :key="mem.agent_id">
								<div>
									<div class="flex items-center justify-between mb-1">
										<span class="text-xs font-mono font-medium text-primary" x-text="mem.agent_id"></span>
										<span class="text-xs text-secondary" x-text="mem.updated_at"></span>
									</div>
									<textarea
										x-model="mem._content"
										rows="2"
										class="textarea textarea-bordered w-full text-xs font-mono resize-y"
									></textarea>
									<div class="flex items-center gap-2 mt-1">
										<button
											@click="confirmDelete('Delete memory for ' + mem.agent_id + '?', () => doDeleteUserMemory(u.id, mem.agent_id))"
											class="btn btn-ghost btn-xs text-secondary hover:text-error"
										>delete</button>
										<button
											@click="saveUserMemory(u.id, mem.agent_id, mem._content)"
											:disabled="mem._content === mem.content"
											class="btn btn-ghost btn-xs text-primary disabled:opacity-30"
										>save</button>
									</div>
								</div>
							</template>
							<!-- Empty state -->
							<div
								x-show="(userMemories[u.id] || []).length === 0 && !u._showAddMemory"
								class="text-xs text-secondary py-2"
							>No memories yet.</div>
							<!-- Add memory form -->
							<div x-show="u._showAddMemory" x-cloak class="space-y-2">
								<select x-model="u._newMemoryAgent" class="select select-bordered select-sm w-full text-xs">
									<option value="" disabled>Select agent...</option>
									<template x-for="a in agents.filter(a => !(userMemories[u.id] || []).some(m => m.agent_id === a.id))" :key="a.id">
										<option :value="a.id" x-text="a.name + ' (' + a.id + ')'"></option>
									</template>
								</select>
								<textarea
									x-model="u._newMemoryContent"
									rows="2"
									placeholder="Memory content..."
									class="textarea textarea-bordered w-full text-xs font-mono resize-y"
								></textarea>
								<div class="flex gap-2">
									<button @click="u._showAddMemory = false" class="btn btn-ghost btn-xs text-secondary">cancel</button>
									<button
										@click="addUserMemory(u)"
										:disabled="!u._newMemoryAgent || !u._newMemoryContent"
										class="btn btn-ghost btn-xs text-primary disabled:opacity-30"
									>add</button>
								</div>
							</div>
							<!-- Add memory trigger -->
							<button
								x-show="!u._showAddMemory"
								@click="u._showAddMemory = true; u._newMemoryAgent = ''; u._newMemoryContent = ''"
								class="text-xs text-primary hover:text-primary-focus cursor-pointer"
							>+ Add memory</button>
						</div>
					</div>
				</template>
			</div>
			<!-- Empty state -->
			<div x-show="legacyUsers.length === 0" x-cloak>
				@ui.EmptyState("No channel users yet — they appear after someone messages Anna.")
			</div>
		</div>
		<!-- Confirm dialog -->
		<div x-show="confirmMsg" x-cloak class="fixed inset-0 z-50 flex items-center justify-center bg-black/40">
			<div class="card bg-base-100 shadow-xl w-full max-w-sm" @click.away="confirmMsg = ''">
				<div class="card-body">
					<p class="text-sm" x-text="confirmMsg"></p>
					<div class="card-actions justify-end mt-4">
						<button @click="confirmMsg = ''" class="btn btn-ghost btn-sm">Cancel</button>
						<button @click="confirmAction(); confirmMsg = ''" class="btn btn-error btn-sm">Confirm</button>
					</div>
				</div>
			</div>
		</div>
	</div>
}
