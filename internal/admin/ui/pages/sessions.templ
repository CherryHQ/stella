package pages

// md-prose scoped styles for rendered markdown inside the transcript.
templ sessionMarkdownStyles() {
	<style>
		.md-prose { font-size: 0.875rem; line-height: 1.65; }
		.md-prose p { margin: 0 0 0.5em; }
		.md-prose p:last-child { margin-bottom: 0; }
		.md-prose ul, .md-prose ol { margin: 0.25em 0 0.5em 1.25em; }
		.md-prose li { margin-bottom: 0.15em; }
		.md-prose code { font-family: 'JetBrains Mono', monospace; font-size: 0.8em; background: var(--color-base-200); border-radius: 3px; padding: 0.1em 0.3em; }
		.md-prose pre { background: var(--color-base-200); border-radius: 6px; padding: 0.6em 0.8em; overflow-x: auto; margin: 0.4em 0; }
		.md-prose pre code { background: none; padding: 0; font-size: 0.78em; }
		.md-prose strong { font-weight: 600; }
		.md-prose blockquote { border-left: 2px solid var(--color-base-300); padding-left: 0.75em; color: var(--color-secondary); margin: 0.4em 0; }
		.md-prose h1, .md-prose h2, .md-prose h3 { font-family: 'DM Serif Text', serif; font-weight: 400; margin: 0.6em 0 0.3em; line-height: 1.3; }
		.md-prose h1 { font-size: 1.2em; }
		.md-prose h2 { font-size: 1.05em; }
		.md-prose h3 { font-size: 0.95em; }
		.md-prose a { color: var(--color-primary); text-decoration: underline; text-underline-offset: 2px; }
	</style>
}

templ SessionsPage() {
	@sessionMarkdownStyles()
	<div
		x-data="sessionsPage()"
		class="-mx-6 -mt-12 border-t border-base-300 grid grid-cols-1 lg:grid-cols-[300px_1fr] overflow-hidden"
		style="height: calc(100vh - 3.5rem);"
	>
		@sessionSidebar()
		@sessionDetailPanel()
	</div>
}

templ sessionSidebar() {
	<aside
		class="border-r border-base-300 flex-col overflow-hidden"
		:class="sessionDetail ? 'hidden lg:flex' : 'flex'"
	>
		<!-- Header: search + filters -->
		<div class="flex-shrink-0 px-3 py-3 space-y-2.5 border-b border-base-300 bg-base-100">
			<div class="flex items-center justify-between">
				<span class="text-xs font-mono text-secondary" x-text="filteredSessions.length + ' sessions'"></span>
				<div class="flex items-center gap-2">
					<button
						@click="showArchived = !showArchived"
						class="text-[10px] font-mono cursor-pointer transition-colors"
						:class="showArchived ? 'text-primary' : 'text-secondary hover:text-base-content'"
						x-text="showArchived ? 'hide archived' : 'show archived'"
					></button>
					<div x-data="{ showNew: false }" class="relative">
						<button @click="showNew = !showNew" class="btn btn-primary btn-xs">New Session</button>
						<div x-show="showNew" x-cloak @click.outside="showNew = false" class="absolute right-0 top-full mt-1 z-10 bg-base-100 border border-base-300 rounded-lg shadow-lg p-3 w-56 space-y-2">
							<div>
								<div class="text-[9px] font-mono text-base-content/40 uppercase tracking-wider mb-1">Agent</div>
								<select x-model="newSessionAgentID" class="select select-xs select-bordered w-full font-mono text-[10px]">
									<option value="">— select agent —</option>
									<template x-for="a in agents" :key="a.id">
										<option :value="a.id" x-text="a.name || a.id"></option>
									</template>
								</select>
							</div>
							<div class="flex gap-1 justify-end">
								<button @click="showNew = false" class="btn btn-ghost btn-xs">Cancel</button>
								<button @click="createSession(); showNew = false" class="btn btn-primary btn-xs" :disabled="!newSessionAgentID">Create</button>
							</div>
						</div>
					</div>
				</div>
			</div>
			<div class="relative">
				<input
					type="text"
					x-model="searchQuery"
					placeholder="Search sessions…"
					class="w-full pl-7 pr-3 py-1.5 text-xs font-mono rounded-md border border-base-300 bg-base-100 focus:outline-none focus:border-primary transition-colors"
				/>
				<svg class="absolute left-2 top-1/2 -translate-y-1/2 w-3.5 h-3.5 text-secondary pointer-events-none" fill="none" viewBox="0 0 24 24" stroke-width="2.5" stroke="currentColor">
					<path stroke-linecap="round" stroke-linejoin="round" d="m21 21-5.197-5.197m0 0A7.5 7.5 0 1 0 5.196 5.196a7.5 7.5 0 0 0 10.607 10.607Z"></path>
				</svg>
			</div>
			<!-- Channel / Agent / User dropdowns -->
			<div class="grid grid-cols-3 gap-2">
				<div>
					<div class="text-[9px] font-mono text-base-content/30 uppercase tracking-wider mb-1">Channel</div>
					<select x-model="filterChannel" class="select select-xs select-bordered w-full font-mono text-[10px]">
						<option value="">all</option>
						<template x-for="ch in uniqueChannels" :key="ch">
							<option :value="ch" :text="channelLabel(ch)"></option>
						</template>
					</select>
				</div>
				<div>
					<div class="text-[9px] font-mono text-base-content/30 uppercase tracking-wider mb-1">Agent</div>
					<select x-model="filterAgent" class="select select-xs select-bordered w-full font-mono text-[10px]">
						<option value="">all</option>
						<template x-for="a in uniqueAgents" :key="a">
							<option :value="a" x-text="a"></option>
						</template>
					</select>
				</div>
				<div>
					<div class="text-[9px] font-mono text-base-content/30 uppercase tracking-wider mb-1">User</div>
					<select x-model="filterUser" class="select select-xs select-bordered w-full font-mono text-[10px]">
						<option value="">all</option>
						<template x-for="u in uniqueUsers" :key="u">
							<option :value="u" x-text="u"></option>
						</template>
					</select>
				</div>
			</div>
		</div>
		<!-- Session list -->
		<div class="flex-1 overflow-y-auto divide-y divide-base-300" x-ref="sessionsList" @scroll.passive="handleSessionsScroll($el)">
			<template x-for="s in filteredSessions" :key="s.id">
				<div
					@click="openSession(s.id)"
					class="px-4 py-3 cursor-pointer transition-colors border-l-2"
					:class="sessionDetail?.id === s.id ? 'border-primary bg-primary/5' : 'border-transparent hover:bg-base-200'"
				>
					<div class="flex items-start justify-between gap-2 mb-1.5">
						<span
							class="text-sm font-medium leading-snug truncate"
							:class="sessionDetail?.id === s.id ? 'text-primary' : (s.archived ? 'text-secondary italic' : '')"
							x-text="s.title || 'Untitled'"
						></span>
						<span class="text-[10px] font-mono text-base-content/30 shrink-0 mt-0.5" x-text="formatTime(s.last_active)"></span>
					</div>
					<div class="flex items-center gap-1.5 flex-wrap">
						<span class="badge badge-ghost badge-xs font-mono" style="font-size:9px;" x-text="channelLabel(s.channel)"></span>
						<template x-if="s.agent_id">
							<span class="text-[10px] font-mono text-secondary" x-text="s.agent_id"></span>
						</template>
						<template x-if="s.user_id">
							<span class="text-[10px] font-mono text-base-content/30" x-text="'· ' + s.user_id"></span>
						</template>
						<template x-if="s.archived">
							<span class="badge badge-ghost badge-xs text-[9px]">archived</span>
						</template>
					</div>
				</div>
			</template>
			<template x-if="filteredSessions.length === 0 && !sessionsLoading">
				<div class="px-4 py-10 text-center">
					<p class="text-xs text-secondary font-mono">No sessions found.</p>
				</div>
			</template>
			<!-- Sessions loading indicator -->
			<div x-show="sessionsLoading" class="px-4 py-3 flex items-center justify-center gap-2">
				<span class="loading loading-spinner loading-xs text-secondary"></span>
				<span class="text-[10px] font-mono text-secondary">Loading…</span>
			</div>
		</div>
	</aside>
}

templ sessionDetailPanel() {
	<div class="flex-col overflow-hidden" :class="sessionDetail ? 'flex' : 'hidden lg:flex'">
		<!-- Empty state -->
		<div x-show="!sessionDetail" x-cloak class="flex-1 flex items-center justify-center">
			<p class="text-sm text-secondary">Select a session to inspect its transcript.</p>
		</div>
		<!-- Session detail -->
		<div x-show="sessionDetail" x-cloak class="flex flex-col h-full overflow-hidden">
			<!-- Header -->
			<div class="flex-shrink-0 px-6 py-4 border-b border-base-300 bg-base-100">
				<div class="flex items-start justify-between gap-4 mb-2">
					<div class="flex items-center gap-2 min-w-0">
						<button @click="backToList()" class="lg:hidden text-xs text-secondary hover:text-base-content cursor-pointer shrink-0">&#8592;</button>
						<h1 class="font-serif text-xl tracking-tight truncate" x-text="sessionDetail?.title || 'Untitled session'"></h1>
					</div>
					<div class="flex items-center gap-1 shrink-0">
						<template x-if="sessionDetail?.archived">
							<span class="badge badge-ghost badge-sm">archived</span>
						</template>
						<button @click="copyID()" class="btn btn-ghost btn-xs font-mono text-[10px] text-secondary gap-1" title="Copy session ID">
							<svg class="w-3 h-3" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor">
								<path stroke-linecap="round" stroke-linejoin="round" d="M15.75 17.25v3.375c0 .621-.504 1.125-1.125 1.125h-9.75a1.125 1.125 0 0 1-1.125-1.125V7.875c0-.621.504-1.125 1.125-1.125H6.75a9.06 9.06 0 0 1 1.5.124m7.5 10.376h3.375c.621 0 1.125-.504 1.125-1.125V11.25c0-4.46-3.243-8.161-7.5-8.876a9.06 9.06 0 0 0-1.5-.124H9.375c-.621 0-1.125.504-1.125 1.125v3.5m7.5 10.375H9.375a1.125 1.125 0 0 1-1.125-1.125v-9.25m12 6.625v-1.875a3.375 3.375 0 0 0-3.375-3.375h-1.5a1.125 1.125 0 0 1-1.125-1.125v-1.5a3.375 3.375 0 0 0-3.375-3.375H9.75"></path>
							</svg>
							Copy ID
						</button>
						<div class="w-px h-4 bg-base-300 mx-0.5"></div>
						<button @click="togglePanel('tools')" class="btn btn-ghost btn-xs text-xs" :class="activePanel === 'tools' ? 'text-primary btn-active' : 'text-secondary'">Tools</button>
						<button @click="togglePanel('prompt')" class="btn btn-ghost btn-xs text-xs" :class="activePanel === 'prompt' ? 'text-primary btn-active' : 'text-secondary'">System Prompt</button>
					</div>
				</div>
				<!-- Metadata -->
				<div class="flex items-center gap-2 flex-wrap text-xs font-mono text-secondary">
					<span class="badge badge-ghost badge-xs" style="font-size:9px;" x-text="channelLabel(sessionDetail?.channel) || 'unknown'"></span>
					<template x-if="sessionDetail?.agent_name || sessionDetail?.agent_id">
						<span class="flex items-center gap-1">
							<span class="text-base-content/20">&#183;</span>
							<span x-text="sessionDetail?.agent_name || sessionDetail?.agent_id"></span>
						</span>
					</template>
					<template x-if="sessionDetail?.user_name">
						<span class="flex items-center gap-1">
							<span class="text-base-content/20">&#183;</span>
							<span x-text="sessionDetail?.user_name"></span>
						</span>
					</template>
					<span class="flex items-center gap-1">
						<span class="text-base-content/20">&#183;</span>
						<span x-text="formatTime(sessionDetail?.last_active)"></span>
					</span>
					<template x-if="sessionTotalTokens > 0">
						<span class="flex items-center gap-1">
							<span class="text-base-content/20">&#183;</span>
							<span class="text-[10px] text-primary/60 font-mono" x-text="sessionTotalTokens.toLocaleString() + ' tok'"></span>
						</span>
					</template>
					<span class="text-[10px] text-base-content/25 ml-1 truncate" x-text="sessionDetail?.id"></span>
				</div>
				<!-- Tools panel -->
				<div x-show="activePanel === 'tools'" x-transition x-cloak class="mt-4 -mx-6 border-t border-base-300">
					<div class="divide-y divide-base-300">
						<template x-for="tool in tools" :key="tool.name">
							<div x-data="{ expanded: false }">
								<button @click="expanded = !expanded" class="w-full text-left flex items-center gap-3 px-6 py-2.5 hover:bg-base-200 transition-colors cursor-pointer">
									<span class="text-[10px] text-secondary" x-text="expanded ? '&#9662;' : '&#9656;'"></span>
									<div class="flex-1 min-w-0">
										<div class="flex items-center gap-2">
											<span class="text-sm font-mono font-medium" x-text="tool.name"></span>
											<span class="badge badge-ghost badge-xs text-[9px]" x-text="tool.category"></span>
										</div>
										<p class="text-[11px] text-secondary mt-0.5 truncate" x-text="tool.description"></p>
									</div>
								</button>
								<div x-show="expanded" x-transition class="px-6 pb-3">
									<pre class="text-[10px] font-mono text-base-content/55 bg-base-200 px-3 py-2 rounded overflow-x-auto" x-text="JSON.stringify(tool.input_schema, null, 2)"></pre>
								</div>
							</div>
						</template>
					</div>
				</div>
				<!-- System prompt panel -->
				<div x-show="activePanel === 'prompt' && sessionSystemPrompt" x-transition x-cloak class="mt-4 -mx-6 px-6 pt-4 border-t border-base-300">
					<div class="flex items-center justify-between mb-2">
						<span class="text-[9px] font-mono text-base-content/30 uppercase tracking-wider">System Prompt</span>
						<span class="text-[10px] font-mono text-base-content/30" x-text="'~' + Math.round(sessionSystemPrompt.length / 4) + ' tokens'"></span>
					</div>
					<div class="max-h-40 overflow-y-auto border-l-2 border-primary/25 pl-3">
						<pre class="text-[10px] font-mono text-base-content/50 whitespace-pre-wrap leading-relaxed" x-text="sessionSystemPrompt"></pre>
					</div>
				</div>
			</div>
			<!-- Transcript -->
			<div x-ref="transcript" class="flex-1 overflow-y-auto px-6 py-6" @scroll.passive="handleTranscriptScroll($el)">
				<!-- Older-messages loading indicator (top of transcript) -->
				<div x-show="sessionMessagesLoading && sessionMessages.length > 0" class="flex items-center justify-center gap-2 mb-4">
					<span class="loading loading-spinner loading-xs text-secondary"></span>
					<span class="text-[10px] font-mono text-secondary">Loading earlier messages…</span>
				</div>
				<div x-show="sessionMessages.length === 0 && !sessionMessagesLoading" x-cloak class="text-center py-16">
					<p class="text-xs text-secondary font-mono">Empty session.</p>
				</div>
				<div class="space-y-4">
					<template x-for="(msg, idx) in processedMessages" :key="idx">
						<div :class="msg.sameRoleAsPrev ? '-mt-2' : ''">
							<!-- User message -->
							<template x-if="msg.role === 'user'">
								<div class="flex gap-3 items-start">
									<div class="w-6 h-6 rounded-full shrink-0 mt-0.5 flex items-center justify-center bg-base-300" :class="msg.sameRoleAsPrev ? 'invisible' : ''">
										<svg class="w-3.5 h-3.5 text-base-content/50" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor">
											<path stroke-linecap="round" stroke-linejoin="round" d="M15.75 6a3.75 3.75 0 1 1-7.5 0 3.75 3.75 0 0 1 7.5 0ZM4.501 20.118a7.5 7.5 0 0 1 14.998 0A17.933 17.933 0 0 1 12 21.75c-2.676 0-5.216-.584-7.499-1.632Z"/>
										</svg>
									</div>
									<div class="flex-1 min-w-0">
										<div class="md-prose" x-html="renderMd(userText(msg))"></div>
										<div x-show="msg.showTimestamp" class="flex items-center gap-2 text-[10px] font-mono text-base-content/30 mt-1">
											<span x-text="formatTime(msg.timestamp)"></span>
											<template x-if="msg.token_count > 0">
												<span class="text-primary/40" x-text="msg.token_count.toLocaleString() + ' tok'"></span>
											</template>
										</div>
									</div>
								</div>
							</template>
							<!-- Assistant message -->
							<template x-if="msg.role === 'assistant'">
								<div class="flex gap-3">
									<div class="w-6 h-6 rounded-full shrink-0 mt-0.5 flex items-center justify-center bg-primary/10" :class="msg.sameRoleAsPrev ? 'invisible' : ''">
										<svg class="w-3.5 h-3.5 text-primary" viewBox="0 0 24 24" fill="currentColor">
											<path d="M11.645 20.91l-.007-.003-.022-.012a15.247 15.247 0 0 1-.383-.218 25.18 25.18 0 0 1-4.244-3.17C4.688 15.36 2.25 12.174 2.25 8.25 2.25 5.322 4.714 3 7.688 3A5.5 5.5 0 0 1 12 5.052 5.5 5.5 0 0 1 16.313 3c2.973 0 5.437 2.322 5.437 5.25 0 3.925-2.438 7.111-4.739 9.256a25.175 25.175 0 0 1-4.244 3.17 15.247 15.247 0 0 1-.383.219l-.022.012-.007.004-.003.001a.752.752 0 0 1-.704 0l-.003-.001Z"/>
										</svg>
									</div>
									<div class="flex-1 min-w-0 space-y-2">
										<template x-for="(block, bi) in (msg.blocks || [])" :key="bi">
											<div>
												<template x-if="block.type === 'thinking'">
													<div x-data="{ expanded: false }" class="pl-3 border-l border-base-300">
														<button @click="expanded = !expanded" class="text-[10px] font-mono text-secondary hover:text-base-content cursor-pointer flex items-center gap-1 py-0.5">
															<span x-text="expanded ? '&#9662;' : '&#9656;'"></span>
															<span class="italic" x-text="block.redacted ? 'thinking (redacted)' : 'thinking'"></span>
															<span class="text-base-content/30" x-text="block.thinking && !block.redacted && block.thinking.length > 100 ? '~' + Math.round(block.thinking.length/4) + ' tok' : ''"></span>
														</button>
														<div x-show="expanded" x-transition class="mt-1">
															<pre class="text-[10px] font-mono text-secondary italic whitespace-pre-wrap max-h-48 overflow-y-auto leading-relaxed bg-base-200/50 px-3 py-2 rounded" x-text="block.thinking || '(redacted)'"></pre>
														</div>
													</div>
												</template>
												<template x-if="block.type === 'text'">
													<div class="md-prose" x-html="renderMd(block.text)"></div>
												</template>
												<template x-if="block.type === 'tool_call'">
													<div x-data="{ expanded: false }" class="pl-3 border-l-2 border-primary/20">
														<!-- Header row -->
														<button @click="expanded = !expanded" class="text-xs font-mono cursor-pointer flex items-center gap-1.5 py-0.5 w-full min-w-0">
															<span x-text="expanded ? '&#9662;' : '&#9656;'" class="text-secondary text-[10px] shrink-0"></span>
															<span class="font-semibold shrink-0" :class="toolColor(block.name)" x-text="block.name"></span>
															<span class="text-base-content/25 text-[10px] shrink-0" x-text="block.id ? '#' + block.id.slice(-4) : ''"></span>
															<span class="text-base-content/40 text-[10px] truncate min-w-0 flex-1 text-left" x-show="!expanded" x-text="toolPreview(block)"></span>
															<template x-if="block.result && !expanded">
																<span class="ml-auto shrink-0 text-[10px] font-mono" :class="block.result.is_error ? 'text-error' : 'text-success'" x-text="block.result.is_error ? '✕ error' : (block.result.content ? '~' + Math.round(block.result.content.length/4) + ' tok' : '✓')"></span>
															</template>
															<template x-if="!block.result && !expanded">
																<span class="ml-auto shrink-0 flex gap-0.5">
																	<span class="w-1 h-1 rounded-full bg-primary/50 animate-bounce" style="animation-delay:0ms"></span>
																	<span class="w-1 h-1 rounded-full bg-primary/50 animate-bounce" style="animation-delay:150ms"></span>
																	<span class="w-1 h-1 rounded-full bg-primary/50 animate-bounce" style="animation-delay:300ms"></span>
																</span>
															</template>
														</button>
														<!-- Expanded content -->
														<div x-show="expanded" x-transition class="mt-1 space-y-1.5">
															<!-- Bash: terminal style -->
															<div x-show="block.name === 'bash'" class="bg-base-300/60 rounded overflow-hidden">
																<div class="px-2.5 py-1 text-[9px] font-mono text-base-content/40 border-b border-base-300 flex gap-1.5 items-center">
																	<span class="text-warning font-bold">$</span>
																	<span>bash</span>
																</div>
																<pre class="text-[10px] font-mono text-warning/80 px-3 py-2 whitespace-pre-wrap overflow-x-auto leading-relaxed" x-text="block.arguments?.command || block.arguments?.input || JSON.stringify(block.arguments, null, 2)"></pre>
															</div>
															<!-- Skill: structured key-value -->
															<div x-show="block.name === 'skill' || block.name === 'skills'" class="bg-base-200 rounded overflow-hidden">
																<div class="px-2.5 py-1 text-[9px] font-mono text-base-content/40 border-b border-base-300 flex gap-1.5 items-center">
																	<span class="text-info font-bold">◈</span>
																	<span>skill</span>
																</div>
																<div class="px-3 py-2 space-y-1">
																	<template x-if="block.arguments?.skill || block.arguments?.name">
																		<div class="flex gap-2 text-[10px] font-mono items-baseline">
																			<span class="text-base-content/35 w-10 shrink-0">skill</span>
																			<span class="text-info font-semibold" x-text="block.arguments?.skill || block.arguments?.name"></span>
																		</div>
																	</template>
																	<template x-if="block.arguments?.action">
																		<div class="flex gap-2 text-[10px] font-mono items-baseline">
																			<span class="text-base-content/35 w-10 shrink-0">action</span>
																			<span class="text-base-content/70" x-text="block.arguments?.action"></span>
																		</div>
																	</template>
																	<template x-if="block.arguments?.args || block.arguments?.input">
																		<div class="flex gap-2 text-[10px] font-mono items-baseline">
																			<span class="text-base-content/35 w-10 shrink-0">args</span>
																			<span class="text-base-content/60 whitespace-pre-wrap break-all" x-text="block.arguments?.args || block.arguments?.input"></span>
																		</div>
																	</template>
																</div>
															</div>
															<!-- Memory -->
															<div x-show="block.name === 'memory'" class="bg-base-200 rounded overflow-hidden">
																<div class="px-2.5 py-1 text-[9px] font-mono text-base-content/40 border-b border-base-300 flex gap-1.5 items-center">
																	<span class="text-accent font-bold">◯</span><span>memory</span><span class="text-accent font-semibold ml-1" x-text="block.arguments?.action || block.arguments?.input"></span>
																</div>
																<div class="px-3 py-2 space-y-1">
																	<template x-if="block.arguments?.pattern">
																		<div class="flex gap-2 text-[10px] font-mono"><span class="text-base-content/35 w-14 shrink-0">pattern</span><span class="text-base-content/70" x-text="block.arguments.pattern"></span></div>
																	</template>
																	<template x-if="block.arguments?.history_scope">
																		<div class="flex gap-2 text-[10px] font-mono"><span class="text-base-content/35 w-14 shrink-0">scope</span><span class="text-base-content/70" x-text="block.arguments.history_scope"></span></div>
																	</template>
																	<template x-if="block.arguments?.summary_id">
																		<div class="flex gap-2 text-[10px] font-mono"><span class="text-base-content/35 w-14 shrink-0">id</span><span class="text-base-content/60" x-text="block.arguments.summary_id"></span></div>
																	</template>
																	<template x-if="block.arguments?.constraint_text">
																		<div class="flex gap-2 text-[10px] font-mono"><span class="text-base-content/35 w-14 shrink-0">constraint</span><span class="text-base-content/70" x-text="block.arguments.constraint_text"></span></div>
																	</template>
																	<template x-if="block.arguments?.content">
																		<div class="text-[10px] font-mono text-base-content/50 bg-base-300/50 px-2 py-1.5 rounded mt-1 whitespace-pre-wrap max-h-24 overflow-y-auto" x-text="block.arguments.content"></div>
																	</template>
																</div>
															</div>
															<!-- Read -->
															<div x-show="block.name === 'read'" class="bg-base-200 rounded overflow-hidden">
																<div class="px-2.5 py-1 text-[9px] font-mono text-base-content/40 border-b border-base-300 flex gap-1.5 items-center">
																	<span class="text-secondary font-bold">▤</span><span>read</span>
																</div>
																<div class="px-3 py-2 space-y-1">
																	<div class="flex gap-2 text-[10px] font-mono"><span class="text-base-content/35 w-10 shrink-0">path</span><span class="text-secondary font-medium break-all" x-text="block.arguments?.path || block.arguments?.file_path || block.arguments?.input"></span></div>
																	<template x-if="block.arguments?.offset">
																		<div class="flex gap-2 text-[10px] font-mono"><span class="text-base-content/35 w-10 shrink-0">from</span><span class="text-base-content/60" x-text="'line ' + block.arguments.offset"></span></div>
																	</template>
																	<template x-if="block.arguments?.limit">
																		<div class="flex gap-2 text-[10px] font-mono"><span class="text-base-content/35 w-10 shrink-0">limit</span><span class="text-base-content/60" x-text="block.arguments.limit + ' lines'"></span></div>
																	</template>
																</div>
															</div>
															<!-- Write -->
															<div x-show="block.name === 'write'" class="bg-base-200 rounded overflow-hidden">
																<div class="px-2.5 py-1 text-[9px] font-mono text-base-content/40 border-b border-base-300 flex gap-1.5 items-center">
																	<span class="text-secondary font-bold">✎</span><span>write</span>
																	<span class="ml-auto text-base-content/30" x-text="block.arguments?.content ? block.arguments.content.split('\\n').length + ' lines' : ''"></span>
																</div>
																<div class="px-3 py-2">
																	<div class="flex gap-2 text-[10px] font-mono"><span class="text-base-content/35 w-10 shrink-0">path</span><span class="text-secondary font-medium break-all" x-text="block.arguments?.path || block.arguments?.file_path || block.arguments?.input"></span></div>
																</div>
															</div>
															<!-- Edit -->
															<div x-show="block.name === 'edit'" class="bg-base-200 rounded overflow-hidden">
																<div class="px-2.5 py-1 text-[9px] font-mono text-base-content/40 border-b border-base-300 flex gap-1.5 items-center">
																	<span class="text-secondary font-bold">∂</span><span>edit</span>
																</div>
																<div class="px-3 py-2 space-y-1.5">
																	<div class="flex gap-2 text-[10px] font-mono"><span class="text-base-content/35 w-10 shrink-0">path</span><span class="text-secondary font-medium break-all" x-text="block.arguments?.path || block.arguments?.file_path || block.arguments?.input"></span></div>
																	<template x-if="block.arguments?.oldText || block.arguments?.old_string">
																		<div><div class="text-[9px] font-mono text-error/60 mb-0.5">- remove</div><pre class="text-[10px] font-mono text-error/70 bg-error/5 px-2 py-1.5 rounded max-h-20 overflow-y-auto whitespace-pre-wrap" x-text="(block.arguments?.oldText || block.arguments?.old_string || '').slice(0, 300)"></pre></div>
																	</template>
																	<template x-if="block.arguments?.newText || block.arguments?.new_string">
																		<div><div class="text-[9px] font-mono text-success/60 mb-0.5">+ insert</div><pre class="text-[10px] font-mono text-success/70 bg-success/5 px-2 py-1.5 rounded max-h-20 overflow-y-auto whitespace-pre-wrap" x-text="(block.arguments?.newText || block.arguments?.new_string || '').slice(0, 300)"></pre></div>
																	</template>
																</div>
															</div>
															<!-- Agent -->
															<div x-show="block.name === 'agent'" class="bg-base-200 rounded overflow-hidden">
																<div class="px-2.5 py-1 text-[9px] font-mono text-base-content/40 border-b border-base-300 flex gap-1.5 items-center">
																	<span class="text-primary font-bold">⬡</span><span>agent</span>
																	<span class="ml-auto text-base-content/30" x-text="(block.arguments?.tasks || []).length + ' task(s)'"></span>
																</div>
																<div class="divide-y divide-base-300">
																	<template x-for="(task, ti) in (block.arguments?.tasks || [])" :key="ti">
																		<div class="px-3 py-2">
																			<div class="flex items-center gap-1.5 mb-1">
																				<span class="text-[9px] font-mono text-primary/60 bg-primary/10 px-1.5 py-0.5 rounded" x-text="task.id || ('task_' + ti)"></span>
																				<span class="text-[9px] font-mono text-base-content/40" x-show="task.preset" x-text="'@ ' + task.preset"></span>
																			</div>
																			<div class="text-[10px] font-mono text-base-content/60 leading-relaxed" x-text="(task.task || '').slice(0, 200) + ((task.task || '').length > 200 ? '\u2026' : '')"></div>
																		</div>
																	</template>
																</div>
															</div>
															<!-- Default: JSON -->
															<div x-show="!['bash','skill','skills','memory','read','write','edit','agent'].includes(block.name)" class="bg-base-200 rounded overflow-hidden">
																<div class="px-2.5 py-1 text-[9px] font-mono text-base-content/40 border-b border-base-300">input</div>
																<pre class="text-[10px] font-mono text-base-content/60 px-3 py-2 overflow-x-auto max-h-64 overflow-y-auto" x-text="JSON.stringify(block.arguments, null, 2)"></pre>
															</div>
															<!-- Result -->
															<template x-if="block.result">
																<div class="rounded overflow-hidden" :class="block.result.is_error ? 'border border-error/30' : 'border border-success/20'">
																	<div class="px-2.5 py-1 text-[9px] font-mono border-b flex items-center gap-1.5" :class="block.result.is_error ? 'text-error border-error/30 bg-error/5' : 'text-success border-success/20 bg-success/5'">
																		<span x-text="block.result.is_error ? '✕' : '✓'"></span>
																		<span x-text="block.result.is_error ? 'error' : 'result'"></span>
																		<span class="ml-auto text-base-content/30" x-text="block.result.content ? '~' + Math.round(block.result.content.length/4) + ' tok' : ''"></span>
																	</div>
																	<pre class="text-[10px] font-mono whitespace-pre-wrap max-h-48 overflow-y-auto leading-relaxed px-3 py-2" :class="block.result.is_error ? 'text-error/70' : 'text-base-content/50'" x-text="block.result.content || '(empty)'"></pre>
																</div>
															</template>
														</div>
													</div>
												</template>
											</div>
										</template>
										<div x-show="msg.showTimestamp" class="flex items-center gap-2 text-[10px] font-mono text-base-content/25">
											<span x-show="msg.model" x-text="msg.model"></span>
											<span x-text="formatTime(msg.timestamp)"></span>
											<template x-if="msg.token_count > 0">
												<span class="text-primary/40" x-text="msg.token_count.toLocaleString() + ' tok'"></span>
											</template>
										</div>
									</div>
								</div>
							</template>
							</div>
					</template>
				</div>
			</div>
			<!-- Message input -->
			<div x-show="sessionDetail && sessionDetail.user_id === currentUserID" x-cloak class="flex-shrink-0 px-4 pb-4 pt-2 bg-base-100 border-t border-base-300">
				<div
					class="relative rounded-2xl border bg-base-100 transition-colors shadow-sm"
					:class="isStreaming ? 'border-primary/40' : 'border-base-300 focus-within:border-primary/60'"
				>
					<textarea
						x-model="userInput"
						@keydown.meta.enter.prevent="sendMessage()"
						@keydown.ctrl.enter.prevent="sendMessage()"
						@input="$el.style.height = 'auto'; $el.style.height = Math.min($el.scrollHeight, 160) + 'px'"
						placeholder="Message…"
						class="w-full px-4 pt-3 pb-11 text-sm bg-transparent border-0 resize-none focus:outline-none leading-relaxed overflow-y-auto"
						style="min-height: 52px; max-height: 160px;"
						rows="1"
						:disabled="isStreaming"
					></textarea>
					<div class="absolute bottom-2.5 left-4 right-3 flex items-center justify-between pointer-events-none">
						<span class="text-[10px] font-mono text-base-content/20 select-none" x-show="!isStreaming">⌘↵ to send</span>
						<span class="text-[10px] font-mono text-primary/50 select-none" x-show="isStreaming">generating…</span>
						<div class="flex items-center gap-1 pointer-events-auto">
							<button
								x-show="isStreaming"
								@click="abortMessage()"
								class="btn btn-ghost btn-xs text-error gap-1 rounded-lg"
							>
								<svg class="w-3.5 h-3.5" fill="currentColor" viewBox="0 0 24 24"><rect x="5" y="5" width="14" height="14" rx="2"/></svg>
								Stop
							</button>
							<button
								x-show="!isStreaming"
								@click="sendMessage()"
								class="btn btn-primary btn-sm rounded-xl gap-1.5"
								:disabled="!userInput.trim()"
							>
								<svg class="w-4 h-4" viewBox="0 0 24 24" fill="currentColor"><path d="M3.478 2.405a.75.75 0 0 0-.926.94l2.432 7.905H13.5a.75.75 0 0 1 0 1.5H4.984l-2.432 7.905a.75.75 0 0 0 .926.94 60.519 60.519 0 0 0 18.445-8.986.75.75 0 0 0 0-1.218A60.517 60.517 0 0 0 3.478 2.405Z"/></svg>
								Send
							</button>
						</div>
					</div>
				</div>
			</div>
		</div>
	</div>
}
