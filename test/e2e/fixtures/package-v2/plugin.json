{
  "$schema": "https://agent-plugins.org/schemas/1.0.0/plugin.schema.json",
  "name": "e2e.package",
  "version": "2.0.0",
  "description": "E2E package v2",
  "extensions": {
    "com.cherryhq.stella": {
      "version": "1",
      "oauth": [
        {
          "provider": "github",
          "scopes": ["repo"],
          "bindings": [
            { "credential": "access_token", "env_var": "GITHUB_TOKEN" }
          ]
        }
      ]
    }
  }
}
