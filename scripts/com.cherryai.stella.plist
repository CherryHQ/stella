<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  macOS LaunchAgent for stella daemon.

  Install (substitutes your home directory and stella binary path automatically):
    sed "s|HOME_DIR|$HOME|g; s|STELLA_BIN|$(which stella)|g" com.cherryai.stella.plist \
      > ~/Library/LaunchAgents/com.cherryai.stella.plist
    mkdir -p ~/Library/Logs/stella
    launchctl load ~/Library/LaunchAgents/com.cherryai.stella.plist

  Uninstall:
    launchctl unload ~/Library/LaunchAgents/com.cherryai.stella.plist
    rm ~/Library/LaunchAgents/com.cherryai.stella.plist

  Logs:
    ~/Library/Logs/stella/stella.log

  All configuration is managed via: stella --open
-->
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.cherryai.stella</string>

    <key>ProgramArguments</key>
    <array>
        <string>STELLA_BIN</string>
        <!-- Uncomment to expose the admin panel on port 8080 -->
        <!-- <string>--port</string> -->
        <!-- <string>8080</string> -->
    </array>

    <!-- Start automatically when the user logs in -->
    <key>RunAtLoad</key>
    <true/>

    <!-- Restart on crash; do not restart on clean exit -->
    <key>KeepAlive</key>
    <dict>
        <key>SuccessfulExit</key>
        <false/>
    </dict>

    <!-- Log destinations (HOME_DIR is replaced by the install command above) -->
    <key>StandardOutPath</key>
    <string>HOME_DIR/Library/Logs/stella/stella.log</string>
    <key>StandardErrorPath</key>
    <string>HOME_DIR/Library/Logs/stella/stella.log</string>

    <!-- Throttle rapid restarts: wait 10 s between attempts -->
    <key>ThrottleInterval</key>
    <integer>10</integer>
</dict>
</plist>
