[Unit]
Description=stella — self-hosted AI assistant daemon
Documentation=https://stella.cherryin.com/docs
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=stella
Group=stella
WorkingDirectory=/home/stella

ExecStart=STELLA_BIN
Restart=on-failure
RestartSec=5
TimeoutStopSec=30

# Data directory — all config lives in the database
Environment=STELLA_HOME=/home/stella/.stella

# Linux boxsh prerequisites live on the host, not in this unit:
# - install `uidmap` (`newuidmap`/`newgidmap`)
# - configure /etc/subuid and /etc/subgid for the service user
# - allow unprivileged user namespaces
# - on some Ubuntu hosts, set:
#     kernel.apparmor_restrict_unprivileged_userns=0
# See docs: /docs/getting-started/deployment#boxsh-sandbox-prerequisites-linux

# Optional: expose admin panel for runtime config changes
# ExecStart=STELLA_BIN --admin-port 8080

# Harden the service
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ReadWritePaths=/home/stella/.stella

[Install]
WantedBy=multi-user.target
