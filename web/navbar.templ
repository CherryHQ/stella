package web

type navItem struct {
	ID       string
	Label    string
	Href     string
	AdminOnly bool
}

var navItems = []navItem{
	{ID: "providers", Label: "Providers", Href: "/providers", AdminOnly: true},
	{ID: "agents", Label: "Agents", Href: "/agents"},
	{ID: "channels", Label: "Channels", Href: "/channels"},
	{ID: "credentials", Label: "Credentials", Href: "/credentials"},
	{ID: "users", Label: "Users", Href: "/users", AdminOnly: true},
	{ID: "sessions", Label: "Sessions", Href: "/sessions"},
	{ID: "scheduler", Label: "Scheduler", Href: "/scheduler"},
	{ID: "plugins", Label: "Plugins", Href: "/plugins", AdminOnly: true},
}

func visibleNavItems(isAdmin bool) []navItem {
	var items []navItem
	for _, item := range navItems {
		if !item.AdminOnly || isAdmin {
			items = append(items, item)
		}
	}
	return items
}

func activeNavPage(activePage string, isAdmin bool) string {
	for _, item := range visibleNavItems(isAdmin) {
		if item.ID == activePage {
			return activePage
		}
	}
	return ""
}

func userInitial(username string) string {
	if username == "" {
		return "?"
	}
	r := []rune(username)
	if len(r) == 0 {
		return "?"
	}
	return string(r[0])
}

templ Navbar(activePage string, username string, isAdmin bool) {
	<header class="border-b border-base-300">
		<div class="max-w-6xl mx-auto px-6 h-14 flex items-center justify-between">
			<!-- Logo -->
			if isAdmin {
				<a href="/providers" class="font-serif italic text-primary text-xl tracking-tight select-none">anna</a>
			} else {
				<a href="/agents" class="font-serif italic text-primary text-xl tracking-tight select-none">anna</a>
			}
			<!-- Desktop nav -->
			<nav class="hidden sm:flex items-center gap-1 text-sm" role="navigation" aria-label="Main">
				for i, item := range visibleNavItems(isAdmin) {
					if i > 0 {
						<span class="text-base-300 mx-2 select-none">/</span>
					}
					if item.ID == activePage {
						<a href={ templ.SafeURL(item.Href) } class="py-1 font-medium text-primary transition-colors">
							{ item.Label }
						</a>
					} else {
						<a href={ templ.SafeURL(item.Href) } class="py-1 font-medium text-secondary hover:text-base-content transition-colors">
							{ item.Label }
						</a>
					}
				}
			</nav>
			<!-- Mobile nav -->
			<div class="sm:hidden">
				<select
					x-data={ "{ page: '" + activeNavPage(activePage, isAdmin) + "' }" }
					x-model="page"
					@change="window.location.href = '/' + page"
					class="select select-sm select-ghost"
				>
					for _, item := range visibleNavItems(isAdmin) {
						<option
							value={ item.ID }
							selected?={ item.ID == activeNavPage(activePage, isAdmin) }
						>
							{ item.Label }
						</option>
					}
				</select>
			</div>
			<!-- Right side: account menu -->
			<div class="flex items-center gap-4">
				if username != "" {
					<div x-data class="dropdown dropdown-end">
						<div tabindex="0" role="button" class="btn btn-ghost btn-sm gap-2" aria-label="Open account menu">
							<div class="flex h-7 w-7 items-center justify-center rounded-full bg-base-200 text-xs font-mono font-semibold text-base-content">
								{ userInitial(username) }
							</div>
							<span class="hidden md:inline text-sm font-medium text-secondary">{ username }</span>
							<svg class="w-4 h-4 text-secondary" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor">
								<path stroke-linecap="round" stroke-linejoin="round" d="M19.5 8.25 12 15.75 4.5 8.25"></path>
							</svg>
						</div>
						<div tabindex="0" class="dropdown-content z-10 mt-2 w-64 rounded-box border border-base-300 bg-base-100 p-2 shadow-xl">
							<a href="/account" class="flex items-start gap-3 rounded-lg px-3 py-3 hover:bg-base-200 transition-colors">
								<div class="flex h-9 w-9 shrink-0 items-center justify-center rounded-full bg-base-200 text-sm font-mono font-semibold text-base-content">
									{ userInitial(username) }
								</div>
								<div class="min-w-0 flex-1">
									<p class="text-sm font-medium truncate">{ username }</p>
									<p class="text-xs text-secondary">Account settings</p>
									if isAdmin {
										<span class="badge badge-ghost badge-xs mt-2">admin</span>
									}
								</div>
							</a>
							<div class="my-2 h-px bg-base-300"></div>
							<details class="group rounded-lg">
								<summary class="flex cursor-pointer list-none items-center justify-between rounded-lg px-3 py-2 text-sm hover:bg-base-200 transition-colors">
									<span>Theme</span>
									<svg class="w-4 h-4 text-secondary transition-transform group-open:rotate-180" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor">
										<path stroke-linecap="round" stroke-linejoin="round" d="M19.5 8.25 12 15.75 4.5 8.25"></path>
									</svg>
								</summary>
								<div class="mt-1 max-h-56 overflow-y-auto px-1 pb-1">
									for _, theme := range themeList() {
										<button @click={ "$store.theme.set('" + theme + "')" } class="flex w-full items-center rounded-md px-2 py-2 text-left text-xs font-medium text-secondary hover:bg-base-200 hover:text-base-content transition-colors">
											{ theme }
										</button>
									}
								</div>
							</details>
							<div class="my-2 h-px bg-base-300"></div>
							<form method="POST" action="/api/auth/logout">
								<button type="submit" class="flex w-full items-center rounded-lg px-3 py-2 text-sm text-error hover:bg-error/10 transition-colors"
									onclick="event.preventDefault(); fetch('/api/auth/logout', {method:'POST',credentials:'same-origin'}).then(()=>window.location.href='/login')">
									Log out
								</button>
							</form>
						</div>
					</div>
				}
			</div>
		</div>
	</header>
}

func themeList() []string {
	return []string{
		"terra",
		"light",
		"dark",
		"cupcake",
		"bumblebee",
		"emerald",
		"corporate",
		"synthwave",
		"retro",
		"cyberpunk",
		"valentine",
		"halloween",
		"garden",
		"forest",
		"aqua",
		"lofi",
		"pastel",
		"fantasy",
		"wireframe",
		"black",
		"luxury",
		"dracula",
		"cmyk",
		"autumn",
		"business",
		"acid",
		"lemonade",
		"night",
		"coffee",
		"winter",
		"dim",
		"nord",
		"sunset",
	}
}
