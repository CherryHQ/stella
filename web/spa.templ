package web

templ SPAPage() {
	<!DOCTYPE html>
	<html lang="en">
	<head>
		<meta charset="UTF-8"/>
		<meta name="viewport" content="width=device-width, initial-scale=1.0"/>
		<title>Anna</title>
		@templ.Raw(string(ViteEntry("app")))
	</head>
	<body>
		<div id="app-root"></div>
	</body>
	</html>
}
