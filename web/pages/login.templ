package pages

templ LoginPage() {
	<div x-data="loginPage()" class="min-h-screen flex items-center justify-center bg-base-100">
		<div class="card bg-base-200 shadow-xl w-full max-w-sm">
			<div class="card-body">
				<!-- Logo -->
				<div class="text-center mb-4">
					<span class="font-serif italic text-primary text-3xl tracking-tight select-none">anna</span>
					<p class="text-secondary text-sm mt-1">Admin Panel</p>
				</div>
				<!-- Error message -->
				<div x-show="error" x-cloak class="alert alert-error text-sm mb-4">
					<span x-text="error"></span>
				</div>
				<!-- Login form -->
				<form x-show="!isRegister" @submit.prevent="login()" x-cloak>
					<div class="form-control w-full mb-3">
						<label class="label">
							<span class="label-text font-mono font-medium text-sm">Username</span>
						</label>
						<input
							type="text"
							x-model="username"
							placeholder="username"
							class="input input-bordered w-full text-sm"
							required
							autocomplete="username"
						/>
					</div>
					<div class="form-control w-full mb-5">
						<label class="label">
							<span class="label-text font-mono font-medium text-sm">Password</span>
						</label>
						<input
							type="password"
							x-model="password"
							placeholder="password"
							class="input input-bordered w-full text-sm"
							required
							autocomplete="current-password"
						/>
					</div>
					<button type="submit" :disabled="loading" class="btn btn-primary w-full">
						<span x-show="loading" class="loading loading-spinner loading-xs"></span>
						<span x-text="loading ? 'Signing in...' : 'Sign in'"></span>
					</button>
				</form>
				<!-- Register form -->
				<form x-show="isRegister" @submit.prevent="register()" x-cloak>
					<div class="form-control w-full mb-3">
						<label class="label">
							<span class="label-text font-mono font-medium text-sm">Username</span>
						</label>
						<input
							type="text"
							x-model="username"
							placeholder="username"
							class="input input-bordered w-full text-sm"
							required
							autocomplete="username"
						/>
					</div>
					<div class="form-control w-full mb-3">
						<label class="label">
							<span class="label-text font-mono font-medium text-sm">Password</span>
						</label>
						<input
							type="password"
							x-model="password"
							placeholder="min 8 characters"
							class="input input-bordered w-full text-sm"
							required
							minlength="8"
							autocomplete="new-password"
						/>
					</div>
					<div class="form-control w-full mb-5">
						<label class="label">
							<span class="label-text font-mono font-medium text-sm">Confirm Password</span>
						</label>
						<input
							type="password"
							x-model="confirmPassword"
							placeholder="confirm password"
							class="input input-bordered w-full text-sm"
							required
							minlength="8"
							autocomplete="new-password"
						/>
					</div>
					<button type="submit" :disabled="loading" class="btn btn-primary w-full">
						<span x-show="loading" class="loading loading-spinner loading-xs"></span>
						<span x-text="loading ? 'Creating account...' : 'Create account'"></span>
					</button>
				</form>
				<!-- Toggle -->
				<div class="text-center mt-4">
					<button
						@click="toggleMode()"
						class="btn btn-ghost btn-sm text-secondary"
						x-text="isRegister ? 'Already have an account? Sign in' : 'Need an account? Register'"
					></button>
				</div>
			</div>
		</div>
	</div>
}
