#!/usr/bin/env bash
#MISE description="Build four-platform packages without publishing and check the host archive"
set -euo pipefail

goreleaser release --snapshot --clean --skip=publish

echo "Verifying archive contains stellad..."
goos=$(go env GOOS)
goarch=$(go env GOARCH)

# The archive path can contain a slash when a local branch name contains one,
# so search below dist instead of treating the generated version as a filename.
# No match is an error here: the explicit check below reports it.
archive=$(find dist -type f \( \
  -name "*_${goos}_${goarch}.tar.gz" -o \
  -name "*_${goos}_${goarch}.zip" \
\) -print | head -n 1)
if [ -z "$archive" ]; then
  echo "ERROR: no archive found for host platform" >&2
  exit 1
fi

bin="stellad"
if [ "$goos" = "windows" ]; then
  bin="stellad.exe"
fi

if ! tar tzf "$archive" 2>/dev/null | grep -Eq "(^|/)${bin}$" \
  && ! unzip -l "$archive" 2>/dev/null | grep -Eq " ${bin}$"; then
  echo "ERROR: $bin missing from $archive" >&2
  exit 1
fi

echo "OK: archive $archive contains stellad"
